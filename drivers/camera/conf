# drivers/camera/conf: the cameras and the flashlight.
# CONFIG_HAKIOS_<NAME>=y in a defconfig builds a driver into the kernel; "standard" files are always built.
# tools/hakios-config.py reads this file; docs/drivers-config.md says what each word means and how it reaches XNU.

driver CAMERA
	file    bsd/dev/hakios.camera.c
	help    the cameras (cam=N): the sensors on the CCI bus and the ISP's interface. The sensors, their tables
	help    (fw-camera/) and the pins are the POCO X5 Pro's

driver TORCH
	file    bsd/dev/hakios.torch.c
	help    the flashlight: the flash LED module of the PM8350C (torch=1); it stays off while the battery is too warm

driver S2MPB02_TORCH
	file    bsd/dev/hakios.s2mpb02_torch.c
	requires EXYNOS_HSI2C
	help    the Galaxy S9's flashlight: the S2MPB02's flash block on PERIC1's HSI2C, lit by a pin (torch=N there, the same
	help    steps as the POCO's: 1 a look, 2 once, 3 for iOS through /dev/hakios-torch)

driver EXYNOS_CAMERA
	file    bsd/dev/hakios.exynos_camera.c
	requires EXYNOS_HSI2C
	help    the Galaxy S9's front camera, stage 1 (cam_s9=N): the S5K3H1's supplies on the S2MPB02, its reset and MCLK,
	help    its model ID over I2C (1 a look, 2 powered up, read and powered down; devices/starlte/CAMERA.md has the plan)

standard bsd/dev/hakios.sccam_torch.c
	help    the phone's flashlight under AVF, through the Scion app's camera block (patch 1402)
