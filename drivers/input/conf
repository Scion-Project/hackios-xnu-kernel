# drivers/input/conf: touch, buttons, and the queue they post to.
# CONFIG_HAKIOS_<NAME>=y in a defconfig builds a driver into the kernel; "standard" files are always built.
# tools/hakios-config.py reads this file; docs/drivers-config.md says what each word means and how it reaches XNU.

standard bsd/dev/hakios.input.c
	help    /dev/hakios-touch, the queue of touches and buttons, and where the phone's drivers are started from

driver VIRTIO_INPUT
	file    bsd/dev/hakios.virtio_input.c
	help    QEMU's virtio tablet and keyboard as the touch screen and the buttons (virtio_input=1). QEMU only

driver GOODIX
	file    bsd/dev/hakios.goodix.c
	help    the touch screen: a Goodix GT9916 ("Berlin-D") or a FocalTech FT3680 on SPI (touchscreen=1). The bus,
	help    pins and supplies are the POCO X5 Pro's; another phone with one of these controllers changes those

driver BUTTONS
	file    bsd/dev/hakios.buttons.c
	help    the power and volume keys, read from the PMIC through the SPMI arbiter (buttons=1)

driver EXYNOS_KEYS
	file    bsd/dev/hakios.exynos_keys.c
	help    the Galaxy S9's power, volume and Bixby keys, pins of the Exynos 9810's ALIVE GPIO block (exynos_keys=1).
	help    Bixby is the home button

driver S6SY761
	file    bsd/dev/hakios.s6sy761.c
	requires EXYNOS_HSI2C
	help    the Galaxy S9's touch screen: a Samsung S6SY761 on the Exynos 9810's HSI2C of USI03, the bus driven by this
	help    file (s6sy761=1; s6sy761_steps=N, s6sy761_ipclk=MHz)
