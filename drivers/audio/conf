# drivers/audio/conf: the audio DSP, the speakers, the microphones, and /dev/hakios-audio.
# CONFIG_HAKIOS_<NAME>=y in a defconfig builds a driver into the kernel; "standard" files are always built.
# tools/hakios-config.py reads this file; docs/drivers-config.md says what each word means and how it reaches XNU.

standard bsd/dev/hakios.audio.c
	help    /dev/hakios-audio, the sound iOS plays, to whatever plays it; and where the camera, flashlight, motor
	help    and speaker drivers are started from

driver ADSP
	file    bsd/dev/hakios.adsp.c
	help    the audio DSP started and linked (adsp=1, adsp_step=N); the battery's state comes through it too.
	help    Needs the DSP's firmware from the phone (fw-audio/)

driver SPEAKER
	file    bsd/dev/hakios.speaker.c
	help    the two speaker amplifiers on I2C, and their watch of temperature and battery

driver GUARD
	file    bsd/dev/hakios.guard.c
	help    the speakers' guard: what the samples go through on their way to the amplifiers where no DSP protects the
	help    speakers (a high-pass, three power averages, a peak limiter); for SOUND and EXYNOS_ABOX, nothing of its own

driver SOUND
	file    bsd/dev/hakios.sound.c
	requires ADSP SPEAKER GUARD
	help    the speakers playing (sound=N): what the DSP's services are told, and the feeder, through the speakers' guard
	help    that limits what the amplifiers get

driver MIC
	file    bsd/dev/hakios.mic.c
	requires ADSP SOUND
	help    the microphones, through the audio DSP (mic=N)

driver VIRTIO_SOUND
	file    bsd/dev/hakios.virtio_sound.c
	help    QEMU's virtio sound device as the player of /dev/hakios-audio (virtio_sound=1). QEMU only

standard bsd/dev/hakios.scsnd.c
	help    SCSND: what iOS plays, to the Scion app's audio ring in the shared framebuffer (patch 1401)

driver EXYNOS_ABOX
	file    bsd/dev/hakios.exynos_abox.c
	requires GUARD EXYNOS_ACPM
	help    the Galaxy S9's speaker path through ABOX, Samsung's audio block, with its CPU off (abox=N, the first N of 8 steps:
	help    power, clocks, pins, UAIF1, the route, RDMA0 with a tone, then /dev/hakios-audio's sink); the MAX98512s through
	help    their driver's hook (sys/hakios.exynos_abox.h)
