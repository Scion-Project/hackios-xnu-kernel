# drivers/gpu/conf: the GPU.
# CONFIG_HAKIOS_<NAME>=y in a defconfig builds a driver into the kernel; "standard" files are always built.
# tools/hakios-config.py reads this file; docs/drivers-config.md says what each word means and how it reaches XNU.

driver ADRENO
	file    bsd/dev/hakios.adreno.c
	file    iokit/Kernel/hakios.gpu.cpp iokitcpp
	help    the Adreno 642L of the SC7280 woken step by step (adreno=N), and HakiosGPU, the IOKit service Mesa and
	help    the window server draw through (gpu=1, adreno_keep=1). Needs the GPU's firmware from the phone (fw-gpu/)

driver MALI
	file    bsd/dev/hakios.mali.c
	file    iokit/Kernel/hakios.mali.cpp iokitcpp
	requires EXYNOS_ACPM
	help    the Galaxy S9's Mali-G72 MP18 (Exynos 9810) brought up step by step (mali=N, 9 for all), and HakiosMali, the
	help    IOKit service Mesa's panfrost draws through; mali_gov=1 sets its clock (260, 455, 572 MHz) after its load and
	help    the G3D's temperature. HakiOS's Mali-G52 driver of the Infinix Hot 20, ported

standard bsd/dev/hakios.vgpu.c
	help    the virtio GPU (AVF): the 2D display path, the cursor queue and the device's interrupts (patches 1202, 1300-1305)

standard bsd/dev/hakios.vgpu3d.c
	help    SCGPU: /dev/vgpu3d, OpenGL ES through the Scion app's own gfxstream (its stream ring and doorbell)

standard bsd/dev/hakios.vgpu3d_xnu.c
	help    SCGPU's glue to XNU: memory, mapping and waiting

standard iokit/Kernel/hakios.backlight.cpp iokitcpp
	help    the panel's brightness, whichever phone: panel drivers register (hakios_panel_register), the display service's
	help    "brightness" reaches them; boot-arg backlight=1 publishes AppleARMBacklight and says what iOS sets on it,
	help    backlight=2 also takes its brightness

driver EXYNOS_DPU
	file    bsd/dev/hakios.exynos_dpu.c
	help    the Galaxy S9's display controller as the display's scan-out: frames flipped between buffers at the DECON's
	help    refresh, no tearing (fb_flip=1), and the iPhone's picture enlarged to the panel by the DPP's VGF0 scaler
	help    instead of the processor (fb_dpp=1); with fb_zc=1 the window server's display surfaces are made of its
	help    pool and scanned out as they are, nothing copied; fps_log=1 reads its refresh count. Off unless asked for

driver S6E3HA8
	file    bsd/dev/hakios.s6e3ha8.c
	help    the Galaxy S9's panel brightness through DSIM0's command FIFO: the gamma worked out from the panel's MTP as
	help    Samsung's kernel does (hakios.s6e3ha8_gamma.h) and the AOR, Samsung's tables for each level (panel=1;
	help    kern.hakios.brightness 0-255, panel_brightness=N at start; panel_gamma=0 the AOR alone)
