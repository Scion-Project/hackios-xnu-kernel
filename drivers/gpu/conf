# drivers/gpu/conf: the GPU.
# CONFIG_HAKIOS_<NAME>=y in a defconfig builds a driver into the kernel; "standard" files are always built.
# tools/hakios-config.py reads this file; docs/drivers-config.md says what each word means and how it reaches XNU.

driver ADRENO
	file    bsd/dev/hakios.adreno.c
	file    iokit/Kernel/hakios.gpu.cpp iokitcpp
	help    the Adreno 642L of the SC7280 woken step by step (adreno=N), and HakiosGPU, the IOKit service Mesa and
	help    the window server draw through (gpu=1, adreno_keep=1). Needs the GPU's firmware from the phone (fw-gpu/)

standard bsd/dev/hakios.vgpu.c
	help    the virtio GPU (AVF): the 2D display path, the cursor queue and the device's interrupts (patches 1202, 1300-1305)

standard bsd/dev/hakios.vgpu3d.c
	help    SCGPU: /dev/vgpu3d, OpenGL ES through the Scion app's own gfxstream (its stream ring and doorbell)

standard bsd/dev/hakios.vgpu3d_xnu.c
	help    SCGPU's glue to XNU: memory, mapping and waiting

driver S6E3HA8
	file    bsd/dev/hakios.s6e3ha8.c
	help    the Galaxy S9's panel brightness: its AOR sent through DSIM0's command FIFO (panel=1; kern.hakios.brightness
	help    0-255, panel_brightness=N at start)
