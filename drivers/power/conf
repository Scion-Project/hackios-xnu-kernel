# drivers/power/conf: the battery, the processor's clock, temperatures, the PMICs, the guards of a run left alone.
# CONFIG_HAKIOS_<NAME>=y in a defconfig builds a driver into the kernel; "standard" files are always built.
# tools/hakios-config.py reads this file; docs/drivers-config.md says what each word means and how it reaches XNU.

driver BATTERY
	file    bsd/dev/hakios.battery.c
	file    iokit/Kernel/hakios.battery.cpp iokitcpp
	help    the battery: kern.hakios.battery_*, and HakiosBattery, the IOPMPowerSource iOS reads the charge from
	help    (the state comes from the audio DSP's battery manager, with adsp=1)

driver CPUFREQ
	file    bsd/dev/hakios.cpufreq.c
	help    the clock of the cores the kernel runs on (cpufreq=1), and the memory bus's votes (ddr=)

driver THERMAL
	file    bsd/dev/hakios.thermal.c
	help    the SoC's temperature sensors (thermal=1): kern.hakios.thermal_*, and the run handed back to the
	help    loader when the phone gets too hot (thermal_stop=)

driver PMIC
	file    bsd/dev/hakios.pmic.c
	help    the blocks of the power-management chips the SPMI arbiter shows, and the PMIC's clock (pmic=1); read only

driver BATTGUARD
	file    bsd/dev/hakios.battguard.c
	help    the run handed back to the loader before the battery is flat (battery_stop=<percent>)

standard bsd/dev/hakios.scfb_battery.c
	help    the phone's battery under AVF, as the Scion app writes it into the shared framebuffer (scfb.addr=)

driver MAX77705
	file    bsd/dev/hakios.max77705.c
	requires EXYNOS_HSI2C BATTERY
	help    the Galaxy S9's battery: the fuel gauge and charger of its MAX77705, read (never written) over CMGP's
	help    HSI2C and handed to HakiosBattery, the power source iOS reads (max77705=1; max77705_steps=N, max77705_ipclk=MHz); and its
	help    haptic block, the vibration motor for iOS through /dev/hakios-haptic (max77705_haptic=1)

driver EXYNOS_TMU
	file    bsd/dev/hakios.exynos_tmu.c
	help    the Galaxy S9's temperatures: the Exynos 9810's TMU (BIG, LITTLE, G3D, ISP), read with each sensor's fuses
	help    (tmu=1), published as kern.hakios.temp.* and the POCO's kern.hakios.thermal_* (tmu=2), and the run ended or the
	help    phone powered off when a zone or the battery is too hot (tmu=3; tmu_stop=, tmu_batt_stop=, tmu_off=1)
