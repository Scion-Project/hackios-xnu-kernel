# drivers/bluetooth/conf: Bluetooth.
# CONFIG_HAKIOS_<NAME>=y in a defconfig builds a driver into the kernel; "standard" files are always built.
# tools/hakios-config.py reads this file; docs/drivers-config.md says what each word means and how it reaches XNU.

driver BT
	file    bsd/dev/hakios.bt.c
	help    the Bluetooth half of the WCN6750: step one, a read-only look at its three pins (bt=1)

driver BCM4361_BT
	file    bsd/dev/hakios.bcm4361_bt.c
	file    iokit/Kernel/hakios.bt_node.cpp iokitcpp
	requires EXYNOS_HSI2C
	help    the Galaxy S9's Bluetooth: the BCM4361's Bluetooth half on UART_BT (out of its USI reset), powered by BT_EN on
	help    the PCAL6524 expander, HCI over H4, Broadcom's patch from the phone, then 4 Mbaud with RTS/CTS (bt=N there, 7
	help    steps: 1 a look, 2 the expander, 3 the UART in loopback, 4 the chip powered, 5 HCI_Reset and its version, 6 the
	help    patch and the version again, 7 the rate raised and the chip kept: the USB console's "bt" and "bt scan", and
	help    /dev/cu.bluetooth, the kernel control com.apple.uart.bluetooth that iOS's BlueTool and bluetoothd open, and a
	help    "bluetooth" registry entry for bluetoothd; userland's BT=1 has iOS use it). No host stack in the kernel. Needs
	help    the phone's bcm4361B2 .hcd (its VENDOR, with ufs=2, or fw-bt/; BLUETOOTH.md of starlte)
