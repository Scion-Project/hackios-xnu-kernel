diff --git a/host/virtio_gpu_frontend.cpp b/host/virtio_gpu_frontend.cpp
index 4c5c3e1..7d54575 100644
--- a/host/virtio_gpu_frontend.cpp
+++ b/host/virtio_gpu_frontend.cpp
@@ -1021,12 +1021,22 @@ void VirtioGpuFrontend::setupWindow(void* nativeWindowHandle, int32_t windowX, i
         return;
     }
 
+    // An app's window comes and goes (Scion: its SurfaceView is destroyed when the activity
+    // stops): NULL takes the subwindow away before the native window is released, and another
+    // window replaces the one there was instead of being ignored.
+    if (nativeWindowHandle == nullptr) {
+        mRenderer->destroyOpenGLSubwindow();
+        mSubWindowHandle = nullptr;
+        return;
+    }
+    const bool replace = mSubWindowHandle != nullptr && mSubWindowHandle != nativeWindowHandle;
+    mSubWindowHandle = nativeWindowHandle;
     bool success = mRenderer->showOpenGLSubwindow((FBNativeWindowType)(uintptr_t)nativeWindowHandle,
                                                   windowX, windowY, windowWidth, windowHeight,
                                                   framebufferWidth, framebufferHeight,
                                                   /*dpr=*/1.0f,
                                                   /*rotation=*/0,
-                                                  /*deleteExisting=*/false,
+                                                  /*deleteExisting=*/replace,
                                                   /*hideWindow=*/false);
     if (!success) {
         GFXSTREAM_ERROR("Failed to setup window: show subwindow failed.");
