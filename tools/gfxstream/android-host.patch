diff --git a/CMakeLists.txt b/CMakeLists.txt
index 639baeb..418ee7a 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -104,6 +104,11 @@ if (APPLE)
 elseif(QNX)
     # TODO(jsimonot): fix build error
     # add_compile_definitions(VK_USE_PLATFORM_SCREEN_QNX)
+elseif(ANDROID)
+    # Android (the NDK): EGL on ANativeWindow, no X11. The AOSP headers Vulkan's Android
+    # path wants (cutils/native_handle.h) come from third_party/android, after the NDK's own.
+    add_compile_definitions(VK_USE_PLATFORM_ANDROID_KHR)
+    add_compile_options(-idirafter ${CMAKE_CURRENT_SOURCE_DIR}/third_party/android/include)
 elseif(UNIX)
     # Use X11 version of EGL platform specific definitions.
     add_compile_definitions(USE_X11)
