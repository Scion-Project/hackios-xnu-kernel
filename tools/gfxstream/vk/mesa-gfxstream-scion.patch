+VkResult ResourceTracker::on_vkGetSemaphoreCounterValue(void* context, VkResult, VkDevice device,
+                                                        VkSemaphore semaphore, uint64_t* pValue) {
+    VkEncoder* enc = (VkEncoder*)context;
+    VkResult res = enc->vkGetSemaphoreCounterValue(device, semaphore, pValue, true /* do lock */);
+    if (res != VK_SUCCESS || !mScionCoherent) return res;
+    bool moved = false;
+    {
+        std::lock_guard<std::recursive_mutex> lock(mLock);
+        uint64_t& seen = mScionSemaphoreSeen[semaphore];
+        moved = *pValue > seen;
+        seen = std::max(seen, *pValue);
+    }
+    if (moved) scionCompleted(enc, device, false);
+    return res;
+}
 
