+VkResult ResourceTracker::on_vkDeviceWaitIdle(void* context, VkResult, VkDevice device) {
+    VkEncoder* enc = (VkEncoder*)context;
+    VkResult res = VK_SUCCESS;
+    if (scionPolledWaits()) {
+        // every queue of the device idle, each through its own stream
+        std::vector<VkQueue> queues;
+        {
+            std::lock_guard<std::recursive_mutex> lock(mLock);
+            for (const auto& [queue, info] : info_VkQueue) {
+                if (info.device == device) queues.push_back(queue);
+            }
+        }
+        for (VkQueue queue : queues) {
+            if (res == VK_SUCCESS) res = scionQueueIdle(getQueueEncoder(queue), queue);
+        }
+    } else {
+        res = enc->vkDeviceWaitIdle(device, true /* do lock */);
+    }
+    if (res == VK_SUCCESS && mScionCoherent) scionCompleted(enc, device, true);
+    return res;
+}
+
+VkResult ResourceTracker::on_vkWaitSemaphores(void* context, VkResult, VkDevice device,
+                                              const VkSemaphoreWaitInfo* pWaitInfo,
+                                              uint64_t timeout) {
+    VkEncoder* enc = (VkEncoder*)context;
+    VkResult res =
+        scionPolledWaits()
+            ? scionPoll(timeout, [&] { return enc->vkWaitSemaphores(device, pWaitInfo, 0, true); })
+            : enc->vkWaitSemaphores(device, pWaitInfo, timeout, true /* do lock */);
+    if (res != VK_SUCCESS || !mScionCoherent) return res;
+    bool moved = !(pWaitInfo->flags & VK_SEMAPHORE_WAIT_ANY_BIT) ? false : true;
+    {
+        std::lock_guard<std::recursive_mutex> lock(mLock);
+        for (uint32_t i = 0; i < pWaitInfo->semaphoreCount; i++) {
+            uint64_t& seen = mScionSemaphoreSeen[pWaitInfo->pSemaphores[i]];
+            if (pWaitInfo->pValues[i] > seen) {
+                moved = true;
+                if (!(pWaitInfo->flags & VK_SEMAPHORE_WAIT_ANY_BIT)) seen = pWaitInfo->pValues[i];
+            }
+        }
+    }
+    if (moved) scionCompleted(enc, device, false);
+    return res;
+}
