-bool ResourceTracker::usingDirectMapping() const { return true; }
+// ---- Scion: host-coherent memory over a stream (no direct mapping) ----------------------------
+//
+// A host that does not map its memory into the guest (VirtioGpuNext off) shows no coherent memory
+// type, and by default the guest shows its types as they are: the application flushes and invalidates
+// what it touches (the spec's minimum of one coherent host-visible type is not met). For a client that
+// cannot, HAKIOS_VK_COHERENCE=emulate calls every host-visible type coherent and keeps it so here:
+//   - an emulated-coherent allocation has a second copy, scionSynced: its bytes as the host last had
+//     them;
+//   - before every submit, the 4 KiB chunks of mapped allocations where the guest's copy differs
+//     from scionSynced (what the CPU wrote) are flushed, in runs: nothing is sent when nothing changed,
+//     and the cost is a memcmp of what is mapped;
+//   - after a wait that saw work complete (a fence, a timeline value that moved, queue or device idle),
+//     and only if something was submitted since the last such pull, the ranges the device may have
+//     written -- buffers and images bound with a usage that lets it write -- are invalidated, into a
+//     merge: bytes the CPU has not touched since the last sync take the host's, the CPU's stay (and
+//     reach the host with the next submit);
+//   - vkMapMemory pulls what an unmapped allocation missed, vkUnmapMemory flushes it.
+// Explicit flushes and invalidates still work (and keep scionSynced right).
+
+static constexpr uint64_t kScionChunk = 4096;
+
+// Scion: a wait made on the host blocks its render thread, and on the phone also the one mailbox
+// through which every reply of every guest process comes (/dev/vgpu3d over SCGPU: a read is a
+// TRANSFER_FROM_HOST the app answers once the render thread has written the bytes). A thread
+// waiting for work another thread has yet to submit -- metal2vulkan's waiter per queue does --
+// would hold up that thread's replies for ever. So waits are polled: each try is a host call with
+// timeout 0, the waiting is done here, in naps from 20 us growing to 2 ms.
+// HAKIOS_VK_HOST_WAITS=1 waits on the host instead.
+static bool scionPolledWaits() {
+    static int on = -1;
+    if (on < 0) {
+        const char* e = getenv("HAKIOS_VK_HOST_WAITS");
+        on = !(e && !strcmp(e, "1"));
+    }
+    return on;
+}
+
+template <typename Try>
+static VkResult scionPoll(uint64_t timeoutNs, Try tryOnce) {
+    auto start = std::chrono::steady_clock::now();
+    uint64_t napUs = 20;
+    for (;;) {
+        VkResult r = tryOnce();
+        if (r != VK_TIMEOUT && r != VK_NOT_READY) return r;
+        uint64_t spent = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                             std::chrono::steady_clock::now() - start)
+                             .count();
+        if (spent >= timeoutNs) return VK_TIMEOUT;
+        uint64_t napNs = std::min<uint64_t>(napUs * 1000, timeoutNs - spent);
+        std::this_thread::sleep_for(std::chrono::nanoseconds(napNs));
+        napUs = std::min<uint64_t>(napUs * 2, 2000);
+    }
+}
+
+// vkQueueWaitIdle as a fence after everything sent to the queue, polled
+VkResult ResourceTracker::scionQueueIdle(VkEncoder* enc, VkQueue queue) {
+    VkDevice device = VK_NULL_HANDLE;
+    VkFence fence = VK_NULL_HANDLE;
+    {
+        std::lock_guard<std::recursive_mutex> lock(mLock);
+        auto it = info_VkQueue.find(queue);
+        if (it == info_VkQueue.end()) return VK_ERROR_DEVICE_LOST;
+        device = it->second.device;
+        auto f = mScionIdleFence.find(queue);
+        if (f != mScionIdleFence.end()) fence = f->second;
+    }
+    if (!fence) {
+        VkFenceCreateInfo info = {VK_STRUCTURE_TYPE_FENCE_CREATE_INFO, nullptr, 0};
+        VkResult r = enc->vkCreateFence(device, &info, nullptr, &fence, true /* do lock */);
+        if (r != VK_SUCCESS) return r;
+        std::lock_guard<std::recursive_mutex> lock(mLock);
+        mScionIdleFence[queue] = fence;
+    }
+    VkResult r = enc->vkResetFences(device, 1, &fence, true /* do lock */);
+    if (r != VK_SUCCESS) return r;
+    if (supportsAsyncQueueSubmit()) {
+        enc->vkQueueSubmitAsyncGOOGLE(queue, 0, nullptr, fence, true /* do lock */);
+    } else if ((r = enc->vkQueueSubmit(queue, 0, nullptr, fence, true /* do lock */)) != VK_SUCCESS) {
+        return r;
+    }
+    return scionPoll(UINT64_MAX, [&] {
+        return enc->vkWaitForFences(device, 1, &fence, VK_TRUE, 0, true /* do lock */);
+    });
+}
+
+void ResourceTracker::scionAdvertiseCoherent(VkPhysicalDeviceMemoryProperties* props) {
+    if (!mScionCoherent) return;
+    uint32_t types = 0;
+    for (uint32_t i = 0; i < props->memoryTypeCount; i++) {
+        VkMemoryPropertyFlags& f = props->memoryTypes[i].propertyFlags;
+        if (f & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT) {
+            f |= VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+            types |= 1u << i;
+        }
+    }
+    mScionCoherentTypes = types;
+}
+
+void ResourceTracker::scionMemoryFlushed(VkDeviceMemory memory, uint64_t offset, uint64_t size) {
+    std::lock_guard<std::recursive_mutex> lock(mLock);
+    auto it = info_VkDeviceMemory.find(memory);
+    if (it == info_VkDeviceMemory.end() || !it->second.scionSynced || !it->second.ptr) return;
+    auto& info = it->second;
+    if (offset >= info.allocationSize) return;
+    size = std::min<uint64_t>(size, info.allocationSize - offset);
+    memcpy(info.scionSynced + offset, info.ptr + offset, size);
+}
+
+void ResourceTracker::scionMemoryInvalidated(VulkanStreamGuest* stream, VkDeviceMemory memory,
+                                             uint64_t offset, uint64_t streamSize) {
+    uint8_t* ptr = nullptr;
+    uint8_t* synced = nullptr;
+    uint64_t mappedSize = 0;
+    if (memory) {
+        std::lock_guard<std::recursive_mutex> lock(mLock);
+        auto it = info_VkDeviceMemory.find(memory);
+        if (it != info_VkDeviceMemory.end()) {
+            ptr = it->second.ptr;
+            synced = it->second.scionSynced;
+            mappedSize = it->second.allocationSize;
+        }
+    }
+    uint64_t keep = (!ptr || offset >= mappedSize) ? 0 : std::min<uint64_t>(streamSize, mappedSize - offset);
+    if (keep && !synced) {
+        stream->read(ptr + offset, keep);
+    } else if (keep) {
+        // a merge, in slices that end on the allocation's 4 KiB chunks
+        static thread_local std::vector<uint8_t> scratch;
+        scratch.resize(256 * 1024);
+        for (uint64_t done = 0; done < keep;) {
+            uint64_t n = std::min<uint64_t>(keep - done, scratch.size());
+            stream->read(scratch.data(), n);
+            for (uint64_t pos = 0; pos < n;) {
+                uint64_t at = offset + done + pos;
+                uint64_t len = std::min<uint64_t>(n - pos, kScionChunk - at % kScionChunk);
+                uint8_t* cpu = ptr + at;
+                uint8_t* was = synced + at;
+                const uint8_t* host = scratch.data() + pos;
+                if (!memcmp(cpu, was, len)) {
+                    memcpy(cpu, host, len);  // the CPU has not written here: the host's
+                } else {
+                    for (uint64_t i = 0; i < len; i++) {
+                        if (cpu[i] == was[i]) cpu[i] = host[i];  // the CPU's bytes stay
+                    }
+                }
+                memcpy(was, host, len);
+                pos += len;
+            }
+            done += n;
+        }
+    }
+    for (uint64_t left = streamSize - keep; left;) {
+        uint8_t skip[4096];
+        uint64_t k = std::min<uint64_t>(left, sizeof(skip));
+        stream->read(skip, k);
+        left -= k;
+    }
+}
+
+void ResourceTracker::scionToHost(VkEncoder* enc, VkDevice device, VkDeviceMemory only) {
+    std::lock_guard<std::recursive_mutex> syncLock(mScionSyncLock);
+    struct Target {
+        VkDeviceMemory memory;
+        uint8_t* ptr;
+        uint8_t* synced;
+        uint64_t size;
+    };
+    std::vector<Target> targets;
+    {
+        std::lock_guard<std::recursive_mutex> lock(mLock);
+        for (auto& [memory, info] : info_VkDeviceMemory) {
+            if (!info.scionSynced || !info.ptr) continue;
+            if (only ? memory != only : (!info.scionMapped || info.device != device)) continue;
+            targets.push_back({memory, info.ptr, info.scionSynced, info.allocationSize});
+        }
+    }
+    std::vector<VkMappedMemoryRange> ranges;
+    for (const auto& t : targets) {
+        uint64_t run = UINT64_MAX;
+        for (uint64_t c = 0; c < t.size; c += kScionChunk) {
+            uint64_t n = std::min(kScionChunk, t.size - c);
+            bool dirty = memcmp(t.ptr + c, t.synced + c, n) != 0;
+            if (dirty && run == UINT64_MAX) run = c;
+            if (!dirty && run != UINT64_MAX) {
+                ranges.push_back({VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE, nullptr, t.memory, run, c - run});
+                run = UINT64_MAX;
+            }
+        }
+        if (run != UINT64_MAX) {
+            ranges.push_back({VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE, nullptr, t.memory, run, VK_WHOLE_SIZE});
+        }
+    }
+    if (!ranges.empty()) {
+        enc->vkFlushMappedMemoryRanges(device, (uint32_t)ranges.size(), ranges.data(), true /* do lock */);
+    }
+}
+
+void ResourceTracker::scionFromHost(VkEncoder* enc, VkDevice device, VkDeviceMemory only) {
+    std::lock_guard<std::recursive_mutex> syncLock(mScionSyncLock);
+    std::vector<VkMappedMemoryRange> ranges;
+    {
+        std::lock_guard<std::recursive_mutex> lock(mLock);
+        uint64_t gen = mScionSync[device].pullGen;
+        for (auto& [memory, info] : info_VkDeviceMemory) {
+            if (!info.scionSynced || !info.ptr) continue;
+            if (only ? memory != only : (!info.scionMapped || info.device != device)) continue;
+            info.scionPullGen = gen;
+            std::vector<std::pair<uint64_t, uint64_t>> spans;
+            for (const auto& [key, span] : info.scionWritable) {
+                uint64_t from = span.first / kScionChunk * kScionChunk;
+                uint64_t to = std::min<uint64_t>(info.allocationSize, span.first + span.second);
+                if (from < to) spans.push_back({from, to});
+            }
+            std::sort(spans.begin(), spans.end());
+            for (size_t i = 0; i < spans.size();) {
+                uint64_t from = spans[i].first, to = spans[i].second;
+                for (i++; i < spans.size() && spans[i].first <= to; i++) {
+                    to = std::max(to, spans[i].second);
+                }
+                ranges.push_back({VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE, nullptr, memory, from, to - from});
+            }
+        }
+    }
+    if (!ranges.empty()) {
+        enc->vkInvalidateMappedMemoryRanges(device, (uint32_t)ranges.size(), ranges.data(),
+                                            true /* do lock */);
+    }
+}
+
+// Work submitted to the device has completed (idle: all of it): pull what it may have written.
+void ResourceTracker::scionCompleted(VkEncoder* enc, VkDevice device, bool idle) {
+    uint64_t submits;
+    {
+        std::lock_guard<std::recursive_mutex> lock(mLock);
+        auto& s = mScionSync[device];
+        if (s.submits == s.pulledAt && s.idleAtPull) return;  // the device has written nothing since
+        submits = s.submits;
+        s.pullGen++;
+    }
+    scionFromHost(enc, device, VK_NULL_HANDLE);
+    std::lock_guard<std::recursive_mutex> lock(mLock);
+    auto& s = mScionSync[device];
+    s.pulledAt = submits;
+    s.idleAtPull = idle;
+}
+
+void ResourceTracker::scionBind(VkDeviceMemory memory, uint64_t key, uint64_t offset,
+                                uint64_t size, bool writable) {
+    std::lock_guard<std::recursive_mutex> lock(mLock);
+    auto it = info_VkDeviceMemory.find(memory);
+    if (it == info_VkDeviceMemory.end() || !it->second.scionSynced || !writable) return;
+    it->second.scionWritable[key] = {offset, size};
+    mScionBinding[key] = memory;
+}
+
+void ResourceTracker::scionUnbind(uint64_t key) {
+    std::lock_guard<std::recursive_mutex> lock(mLock);
+    auto b = mScionBinding.find(key);
+    if (b == mScionBinding.end()) return;
+    auto it = info_VkDeviceMemory.find(b->second);
+    if (it != info_VkDeviceMemory.end()) it->second.scionWritable.erase(key);
+    mScionBinding.erase(b);
+}
