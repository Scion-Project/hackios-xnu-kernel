-        cgen.stmt("auto actualSize = size == VK_WHOLE_SIZE ? sResourceTracker->getMappedSize(memory) : size")
+        cgen.stmt("auto mappedSize = sResourceTracker->getMappedSize(memory)")
+        # Scion: VK_WHOLE_SIZE is the rest of the memory after offset, and never past its end
+        cgen.stmt("auto actualSize = size == VK_WHOLE_SIZE ? (mappedSize > offset ? mappedSize - offset : 0) : size")
+        cgen.stmt("if (offset > mappedSize || actualSize > mappedSize - offset) actualSize = 0")
         cgen.stmt("if (!hostPtr) { %s->write(&streamSize, sizeof(uint64_t)); continue; }" % streamVar)
         cgen.stmt("streamSize = actualSize")
         cgen.stmt("%s->write(&streamSize, sizeof(uint64_t))" % streamVar)
@@ -596,15 +599,17 @@
         cgen.stmt("auto memory = range.memory")
         cgen.stmt("auto size = range.size")
         cgen.stmt("auto offset = range.offset")
-        cgen.stmt("uint64_t streamSize = 0")
-        cgen.stmt("if (!memory) { %s->read(&streamSize, sizeof(uint64_t)); continue; }" % streamVar)
-        cgen.stmt("auto hostPtr = sResourceTracker->getMappedPointer(memory)")
-        cgen.stmt("auto actualSize = size == VK_WHOLE_SIZE ? sResourceTracker->getMappedSize(memory) : size")
-        cgen.stmt("if (!hostPtr) { %s->read(&streamSize, sizeof(uint64_t)); continue; }" % streamVar)
-        cgen.stmt("streamSize = actualSize")
+        # Scion: the host says how many bytes follow (for VK_WHOLE_SIZE, the rest of ITS
+        # allocation, which it rounds up to a page): exactly those are read, as many as fit the
+        # guest's copy are kept, the rest skipped, so that the stream stays in step.
+        cgen.stmt("uint64_t streamSize = 0")
         cgen.stmt("%s->read(&streamSize, sizeof(uint64_t))" % streamVar)
-        cgen.stmt("uint8_t* targetRange = hostPtr + offset")
-        cgen.stmt("%s->read(targetRange, actualSize)" % streamVar)
+        cgen.stmt("auto hostPtr = memory ? sResourceTracker->getMappedPointer(memory) : nullptr")
+        cgen.stmt("auto mappedSize = memory ? sResourceTracker->getMappedSize(memory) : 0")
+        cgen.stmt("uint64_t keep = (!hostPtr || offset >= mappedSize) ? 0 : std::min<uint64_t>(streamSize, mappedSize - offset)")
+        cgen.stmt("if (keep) %s->read(hostPtr + offset, keep)" % streamVar)
+        cgen.stmt("for (uint64_t left = streamSize - keep; left; ) { uint8_t skip[4096]; uint64_t k = left < sizeof(skip) ? left : sizeof(skip); %s->read(skip, k); left -= k; }" % streamVar)
+        cgen.stmt("(void)size")
         cgen.endFor()
         cgen.endIf()
 
