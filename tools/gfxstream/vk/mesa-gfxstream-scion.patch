+bool ResourceTracker::usingDirectMapping() const {
+#if DETECT_OS_APPLE
+    // Scion: a device that cannot map host memory into the guest (kParamHostVisible 0, a byte
+    // pipe) keeps a guest copy of host-visible memory, and vkFlushMappedMemoryRanges /
+    // vkInvalidateMappedMemoryRanges carry its bytes over the stream (VkEncoder). The host must
+    // agree: it does when neither GlDirectMem nor VirtioGpuNext is enabled.
+    return mCaps.params[kParamHostVisible] != 0;
+#else
+    return true;
+#endif
+}
 
