diff --git a/crates/metal2vulkan-runtime/src/host_sync.rs b/crates/metal2vulkan-runtime/src/host_sync.rs
new file mode 100644
index 0000000..68b36b4
--- /dev/null
+++ b/crates/metal2vulkan-runtime/src/host_sync.rs
@@ -0,0 +1,120 @@
+//! Host-visible memory that is not coherent: the ranges the host writes, flushed before the GPU
+//! reads them, and the ranges the GPU writes, invalidated before the host reads them.
+//!
+//! Metal's `Shared` and `Managed` storage needs no flush: the runtime places them, and its own
+//! host-visible buffers, in `HOST_VISIBLE | HOST_COHERENT` memory. A device that lists no such
+//! type (a paravirtual driver that keeps a copy of each mapping in the guest, gfxstream's without
+//! blob memory) gets its host-visible types instead (`memory::candidates`), each placement in
+//! whole `nonCoherentAtomSize` atoms (`memory::place`), and these steps:
+//!
+//! - **Before each batch goes to its `VkQueue`** (`command_buffer/submit.rs`): its command
+//!   buffer's upload arena as written so far (`upload.rs`: tables, constants, status words the
+//!   host wrote); and, at its first batch, every program buffer its commands use
+//!   (`used_resources.rs`'s listing), whole: Metal's host writes to them may be anywhere and at
+//!   any time before the commit. The buffers its commands write are kept for the completion.
+//! - **As it completes** (`CommandBufferShared::complete`, before its status and status words
+//!   are read): its upload arena, and every program buffer its commands write (a tracked write
+//!   use, `tracker::Summary::written`), whole. A buffer the GPU only reads is not invalidated, so
+//!   the host's writes to it while the work runs (a ring of per-frame data) are kept.
+//! - **Where the runtime writes a buffer of its own once, for a command to read** (a new buffer's
+//!   zeros, a buffer made with bytes, a texture's staged texels and staging buffers, a fill's or
+//!   a pattern's bytes, a resident set's table, a tile map, block-decode shapes, a rate map's
+//!   parameters): flushed after the write ([`wrote`], `Staging::written`).
+//! - **Where it reads what the GPU wrote** (a texture's `getBytes` staging, a host step's copy of
+//!   indirect arguments or an execution range): invalidated before the read ([`will_read`],
+//!   `Staging::bytes`).
+//!
+//! `didModifyRange:` needs nothing more: a `Managed` buffer a command uses is flushed whole at its
+//! command buffer's first batch.
+//!
+//! Not covered (wrong on such a driver): an indirect command buffer's records and a visible
+//! function table's words, which the host writes through pointers it keeps; a texture with an
+//! image of its own whose CPU copies go through the host's mapping of it (`host_copy.rs`, which
+//! takes host-cached coherent memory only, so not on such a driver).
+//!
+//! `METAL2VULKAN_HOST_SYNC=always` takes these steps on coherent host-visible memory too, for a
+//! driver that emulates coherence and follows the flushes it is given.
+//!
+//! Patch for Scion (tools/metal/m2v/), under metal2vulkan's licence.
+
+use super::buffer::Buffer;
+use super::device::lock;
+use super::Device;
+use ash::vk;
+use std::sync::OnceLock;
+
+/// A range of a `VkDeviceMemory` the host maps: memory type, memory, offset and size in it.
+#[derive(Clone, Copy, Debug)]
+pub(super) struct HostSpan {
+    pub(super) type_index: u32,
+    pub(super) memory: vk::DeviceMemory,
+    pub(super) offset: u64,
+    pub(super) size: u64,
+}
+
+/// Whether `METAL2VULKAN_HOST_SYNC=always` asks for the steps on coherent memory too.
+pub(super) fn always() -> bool {
+    static ALWAYS: OnceLock<bool> = OnceLock::new();
+    *ALWAYS.get_or_init(|| std::env::var("METAL2VULKAN_HOST_SYNC").is_ok_and(|v| v == "always"))
+}
+
+/// Flush (`true`) or invalidate the spans that lie in memory the host does not see coherently,
+/// each rounded out to whole atoms (placements there take whole atoms, so no neighbour's byte is
+/// in one). A failure leaves the bytes as they were, which is what a driver that cannot flush
+/// does; it is not the command buffer's.
+pub(super) fn sync(device: &Device, spans: &[HostSpan], flush: bool) {
+    if spans.is_empty() {
+        return;
+    }
+    let shared = device.shared();
+    let ranges: Vec<vk::MappedMemoryRange<'static>> = {
+        let memory = lock(&shared.memory);
+        let atom = memory.atom();
+        spans
+            .iter()
+            .filter(|span| span.size != 0 && memory.incoherent(span.type_index))
+            .map(|span| {
+                let start = span.offset - span.offset % atom;
+                let end = span.offset.saturating_add(span.size);
+                let end = end.checked_next_multiple_of(atom).unwrap_or(end);
+                vk::MappedMemoryRange::default()
+                    .memory(span.memory)
+                    .offset(start)
+                    .size(end - start)
+            })
+            .collect()
+    };
+    if ranges.is_empty() {
+        return;
+    }
+    let raw = shared.vk();
+    // SAFETY: each range lies in mapped memory of the device's (a placement's, rounded to atoms
+    // it owns whole), which the caller holds.
+    let _ = unsafe {
+        match flush {
+            true => raw.flush_mapped_memory_ranges(&ranges),
+            false => raw.invalidate_mapped_memory_ranges(&ranges),
+        }
+    };
+}
+
+/// The host wrote `buffer` (the runtime's own, written once before a command reads it): to the
+/// device, where its memory is not coherent.
+pub(super) fn wrote(buffer: &Buffer) {
+    if let Some(span) = buffer.host_span() {
+        sync(buffer.device(), &[span], true);
+    }
+}
+
+/// The host is about to read what the device wrote to `buffer` (a host step's copy of the GPU's
+/// arguments): from the device, where its memory is not coherent.
+pub(super) fn will_read(buffer: &Buffer) {
+    if let Some(span) = buffer.host_span() {
+        sync(buffer.device(), &[span], false);
+    }
+}
+
+/// The spans of `buffers`' bytes, where they lie in host-visible memory.
+pub(super) fn buffer_spans<'a>(buffers: impl IntoIterator<Item = &'a Buffer>) -> Vec<HostSpan> {
+    buffers.into_iter().filter_map(Buffer::host_span).collect()
+}
