+    /// Scion (`host_sync.rs`): whether the buffer stands for the caller's bytes it could not import.
+    pub(super) fn copies_host(&self) -> bool {
+        self.0.copied.get().is_some()
+    }
+
+    /// Scion (`host_sync.rs`): copy the caller's bytes into the buffer's own memory where they
+    /// differ, 4 KiB at a time (`in_` true), or the buffer's into the caller's (false). The spans
+    /// of its own memory the copy in changed, for a flush; and the bytes copied.
+    pub(super) fn copy_host_bytes(&self, in_: bool) -> (Vec<crate::host_sync::HostSpan>, u64) {
+        const CHUNK: usize = 4096;
+        let (Some(copied), Some(own), Some(span)) = (self.0.copied.get(), self.own_contents(), self.host_span())
+        else {
+            return (Vec::new(), 0);
+        };
+        let length = self.length() as usize;
+        let (caller, own) = (copied.pointer.as_ptr(), own.as_ptr());
+        let mut spans: Vec<crate::host_sync::HostSpan> = Vec::new();
+        let mut copied_bytes = 0;
+        let mut at = 0;
+        while at < length {
+            let end = (at + CHUNK).min(length);
+            // SAFETY: both hold `length` bytes from their start (the caller's by the no-copy
+            // contract, the buffer's by its placement); no command reads or writes them meanwhile
+            // (a copy in runs before the batch is submitted, a copy out after its work completed).
+            let (from, to) = unsafe {
+                match in_ {
+                    true => (
+                        std::slice::from_raw_parts(caller.add(at), end - at),
+                        std::slice::from_raw_parts_mut(own.add(at), end - at),
+                    ),
+                    false => (
+                        std::slice::from_raw_parts(own.add(at), end - at),
+                        std::slice::from_raw_parts_mut(caller.add(at), end - at),
+                    ),
+                }
+            };
+            if from != to {
+                to.copy_from_slice(from);
+                copied_bytes += (end - at) as u64;
+                let offset = span.offset + at as u64;
+                match spans.last_mut() {
+                    Some(last) if last.offset + last.size == offset => last.size += (end - at) as u64,
+                    _ => spans.push(crate::host_sync::HostSpan {
+                        offset,
+                        size: (end - at) as u64,
+                        ..span
+                    }),
+                }
+            }
+            at = end;
+        }
+        (spans, copied_bytes)
+    }
