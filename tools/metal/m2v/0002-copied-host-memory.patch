-/// The spans of `buffers`' bytes, where they lie in host-visible memory.
+/// What the copies of no-copy buffers the device could not import moved: bytes in, bytes out, and
+/// the nanoseconds each took (Scion).
+static COPIED: [std::sync::atomic::AtomicU64; 4] = [const { std::sync::atomic::AtomicU64::new(0) }; 4];
+
+/// The counts of the copies of no-copy buffers the device could not import, since the process
+/// started: bytes copied in, bytes copied out, nanoseconds copying in, nanoseconds copying out. Not
+/// a Metal call (Scion).
+pub fn copied_host_counts() -> [u64; 4] {
+    std::array::from_fn(|i| COPIED[i].load(std::sync::atomic::Ordering::Relaxed))
+}
+
+/// The caller's bytes of the copied no-copy buffers among `buffers` into their own memory, where
+/// they changed (before a command buffer's first batch): the spans changed, to flush.
+pub(super) fn copy_in(buffers: &[Buffer]) -> Vec<HostSpan> {
+    let began = std::time::Instant::now();
+    let mut spans = Vec::new();
+    let mut bytes = 0;
+    for buffer in buffers.iter().filter(|buffer| buffer.copies_host()) {
+        let (changed, copied) = buffer.copy_host_bytes(true);
+        spans.extend(changed);
+        bytes += copied;
+    }
+    // the time counts whether anything changed or not: the comparison is the copy in's cost too
+    if buffers.iter().any(Buffer::copies_host) {
+        use std::sync::atomic::Ordering::Relaxed;
+        COPIED[0].fetch_add(bytes, Relaxed);
+        COPIED[2].fetch_add(began.elapsed().as_nanos() as u64, Relaxed);
+    }
+    spans
+}
+
+/// The copied no-copy buffers among `buffers` back into the caller's bytes, where they changed
+/// (as a command buffer that writes them completes, after the invalidate).
+pub(super) fn copy_out(buffers: &[Buffer]) {
+    let began = std::time::Instant::now();
+    let mut bytes = 0;
+    for buffer in buffers.iter().filter(|buffer| buffer.copies_host()) {
+        bytes += buffer.copy_host_bytes(false).1;
+    }
+    if buffers.iter().any(Buffer::copies_host) {
+        use std::sync::atomic::Ordering::Relaxed;
+        COPIED[1].fetch_add(bytes, Relaxed);
+        COPIED[3].fetch_add(began.elapsed().as_nanos() as u64, Relaxed);
+    }
+}
+
+/// The spans of `buffers`' bytes, where they lie in host-visible memory, but the copied no-copy
+/// buffers' (their copy in says which of theirs changed).
 pub(super) fn buffer_spans<'a>(buffers: impl IntoIterator<Item = &'a Buffer>) -> Vec<HostSpan> {
+    buffers.into_iter().filter(|buffer| !buffer.copies_host()).filter_map(Buffer::host_span).collect()
+}
+
+/// The spans of `buffers`' bytes, where they lie in host-visible memory, every one.
+pub(super) fn all_spans<'a>(buffers: impl IntoIterator<Item = &'a Buffer>) -> Vec<HostSpan> {
     buffers.into_iter().filter_map(Buffer::host_span).collect()
 }
