What brcmfmac's control messages are, said (HakiOS): the first completions on the control ring as they are, and
the first ioctls (what was asked, where the response buffer was, how long the response was and its first bytes),
so a setup that stops at the first ioctl says why; then a line for each ioctl and each of the firmware's events.
--- a/brcmfmac/msgbuf.c
+++ b/brcmfmac/msgbuf.c
@@ -291,6 +291,31 @@
 
 static void brcmf_msgbuf_rxbuf_ioctlresp_post(struct brcmf_msgbuf *msgbuf);
 
+/*
+ * (HakiOS) the first control messages, said as they are (lx-msgbuf.patch): the chip's completions on the control
+ * ring, raw, and the first ioctls' responses (where the chip wrote them, how long, their first bytes). LX_MSGBUF_SAY
+ * of each, then quiet.
+ */
+#define LX_MSGBUF_SAY	12
+#define LX_MSGBUF_SAY_SHORT	160	/* (then a line each, without the bytes) */
+static u32 lx_msgbuf_ctl_said, lx_msgbuf_ioctl_said, lx_msgbuf_events_said;
+
+static void lx_msgbuf_hex(const char *what, const void *data, u32 len)
+{
+	static const char digits[] = "0123456789abcdef";
+	const u8 *p = data;
+	char line[3 * 64 + 1];
+	u32 i, n = 0;
+
+	for (i = 0; i < len && i < 64; i++) {
+		line[n++] = digits[p[i] >> 4];
+		line[n++] = digits[p[i] & 15];
+		line[n++] = (i & 3) == 3 ? ' ' : '.';
+	}
+	line[n] = 0;
+	pr_err("lx: msgbuf: %s (%u bytes): %s\n", what, len, line);
+}
+
 
 static struct brcmf_msgbuf_pktids *
 brcmf_msgbuf_init_pktids(u32 nr_array_entries,
@@ -466,6 +491,13 @@
