+		       "%u response and %u event buffers posted\n", cmd, msgbuf->reqid, ifidx, buf_len, len,
+		       msgbuf->ioctbuf_phys_hi, msgbuf->ioctbuf_phys_lo, msgbuf->cur_ioctlrespbuf, msgbuf->cur_eventbuf);
+		lx_msgbuf_hex("ioctl request", request, sizeof(*request));
+		lx_msgbuf_hex("ioctl data", msgbuf->ioctbuf, buf_len);
+	}
 
