# Commands run by the launchd job com.hakios.demo (see com.hakios.demo.plist).
# The Darwin root container on the phone's flash, which the kernel mounts read only on
# /System/Volumes/Darwin at boot (ufs=2 apfs_volume=ufs_darwin, with bootcpu=7): what user space
# sees of it, in an ordinary session.  Darwin's own mount and df first, then ours (vol_ls: ls, cat,
# hashes through read(2) and through a mapping), then every file of /usr/sbin both ways.
# The host's hashes: SystemVersion.plist 47687daabd864929, usr/lib/dyld 602fba9751ad6aa7,
# usr/sbin/mediaserverd 895037cd97f96801 (tools/apfs/apfs-tool census, apfs.py).
/sbin/mount
/bin/df
/redwood/bin/vol_ls fs /System/Volumes/Darwin
/redwood/bin/vol_ls ls /System/Volumes/Darwin
/redwood/bin/vol_ls ls /System/Volumes/Darwin/System/Library/CoreServices
/redwood/bin/vol_ls cat /System/Volumes/Darwin/System/Library/CoreServices/SystemVersion.plist
/redwood/bin/vol_ls hash /System/Volumes/Darwin/System/Library/CoreServices/SystemVersion.plist /System/Volumes/Darwin/usr/lib/dyld /System/Volumes/Darwin/usr/sbin/mediaserverd
/redwood/bin/apfs_mmap_test mmap /System/Volumes/Darwin/usr/sbin
/redwood/bin/apfs_mmap_test read /System/Volumes/Darwin/usr/sbin 65536
