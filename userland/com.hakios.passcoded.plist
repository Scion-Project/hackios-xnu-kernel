<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.hakios.passcoded</string>
	<!-- the stand-in for keybagd's XPC service (src/passcoded.m): Settings' Turn Passcode On, Change Passcode
	     and Turn Passcode Off reach the kernel's key store (MiniAppleKeyStore.cpp) through it, and it posts
	     keybagd's lock_status and first_unlock notifications. Apple's keybagd stays out (mkjobs.py's DENY),
	     so the label must not contain that word. -->
	<key>ProgramArguments</key>
	<array>
		<string>/redwood/bin/passcoded</string>
	</array>
	<key>MachServices</key>
	<dict>
		<key>com.apple.mobile.keybagd.xpc</key>
		<true/>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>UserName</key>
	<string>root</string>
	<key>StandardOutPath</key>
	<string>/dev/console</string>
	<key>StandardErrorPath</key>
	<string>/dev/console</string>
</dict>
</plist>
