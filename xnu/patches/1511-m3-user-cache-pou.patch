+SYSCTL_QUAD(_machdep, OID_AUTO, hakios_ucache_ops, CTLFLAG_KERN | CTLFLAG_RD | CTLFLAG_LOCKED, &hakios_ucache_ops,
+    "EL0 cache maintenance instructions done by the kernel with a clean first");
