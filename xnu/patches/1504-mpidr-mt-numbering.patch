+/*
+ * HakiOS (patch 1504): a device tree that numbers the cores as the firmware does, where the cores' own MPIDR has them
+ * one affinity field higher. The Galaxy S9's Cortex-A55s sit in a DynamIQ cluster: MT set, the core in Affinity1
+ * (core 2 reads 0x81000200). Samsung's device tree, its EL3 and Carbon's PSCI all call that core 2 (Affinity0). Set
+ * when the boot processor's MPIDR is in the device tree only that way; read by the reset vector as well (start.s),
+ * with the MMU off, so it is cleaned to memory.
+ */
+uint32_t ml_mpidr_mt_aff1;
+
+uint32_t
+ml_phys_id_from_mpidr(uint64_t mpidr)
+{
+	if (ml_mpidr_mt_aff1 && (mpidr & (1ULL << 24)) != 0) {
+		return (uint32_t)((mpidr >> MPIDR_AFF1_SHIFT) & (MPIDR_AFF1_MASK | MPIDR_AFF0_MASK));
+	}
+	return (uint32_t)(mpidr & (MPIDR_AFF1_MASK | MPIDR_AFF0_MASK));
+}
+
+static void
+ml_mpidr_numbering(void)
+{
+	uint64_t mpidr = __builtin_arm_rsr64("MPIDR_EL1");
+
+	if (ml_get_cpu_number((uint32_t)mpidr) >= 0 || (mpidr & (1ULL << 24)) == 0) {
+		return;
+	}
+	if (ml_get_cpu_number((uint32_t)(mpidr >> MPIDR_AFF1_SHIFT)) >= 0) {
+		ml_mpidr_mt_aff1 = 1;
+		CleanPoC_DcacheRegion((vm_offset_t)&ml_mpidr_mt_aff1, sizeof(ml_mpidr_mt_aff1));
+	}
+}
+
 int
 ml_get_cpu_number(uint32_t phys_id)
 {
@@ -1332,7 +1367,7 @@
 
 	/* We identify the CPU based on the constant bits of MPIDR_EL1. */
 	MRS(mpidr_el1_value, "MPIDR_EL1");
-	cpu_id = ml_get_cpu_number((uint32_t)mpidr_el1_value);
+	cpu_id = ml_get_cpu_number(ml_phys_id_from_mpidr(mpidr_el1_value));
 
 	assert(cpu_id <= (unsigned int)ml_get_max_cpu_number());
 
@@ -1347,7 +1382,7 @@
 
 	/* We identify the cluster based on the constant bits of MPIDR_EL1. */
 	MRS(mpidr_el1_value, "MPIDR_EL1");
-	cluster_id = ml_get_cluster_number((uint32_t)mpidr_el1_value);
+	cluster_id = ml_get_cluster_number(ml_phys_id_from_mpidr(mpidr_el1_value));
 
 	assert(cluster_id <= (unsigned int)ml_get_max_cluster_number());
 
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -169,6 +169,15 @@
 	// (generic boards: some number their cores in Affinity1 and leave Affinity0 at zero;
 	// a cpu data's phys id is both fields, as the device tree's "reg" has them)
 	and		x0, x15, #0xFFFF					// CPU number in Affinity0, cluster ID in Affinity1
+	// HakiOS (patch 1504): a device tree numbering the cores one affinity field lower than an MT MPIDR
+	// does (the Galaxy S9's A55s: 0x81000200 is its core 2), as ml_phys_id_from_mpidr()
+	adrp	x2, EXT(ml_mpidr_mt_aff1)@page
+	add		x2, x2, EXT(ml_mpidr_mt_aff1)@pageoff
+	ldr		w2, [x2]
+	cbz		w2, Lmpidr_numbered
+	tbz		x15, #24, Lmpidr_numbered
+	ubfx	x0, x15, #8, #16
+Lmpidr_numbered:
 #else
 	and		x0, x15, #0xFF						// CPU number is in MPIDR Affinity Level 0
 #endif
