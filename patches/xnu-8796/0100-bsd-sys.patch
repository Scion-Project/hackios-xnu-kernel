diff --git a/bsd/sys/hakios.vgpu.h b/bsd/sys/hakios.vgpu.h
new file mode 100644
index 0000000000000000000000000000000000000000..061202fcadf9edc8582f70daac437fed755a14bf
--- /dev/null
+++ b/bsd/sys/hakios.vgpu.h
@@ -0,0 +1,54 @@
+/*
+ * virtio-gpu, 2D: a scanout the kernel draws into, for hosts that show one (QEMU with
+ * -device virtio-gpu-pci, crosvm with a display). Under the Android Virtualization Framework a
+ * sideloaded app cannot see crosvm's display, so there the boot framebuffer is the Scion shared
+ * framebuffer instead (avfboot, scfb.*); this is the other way to the screen.
+ *
+ * MiniIOMobileFramebuffer uses it when the loader left no framebuffer: hakios_vgpu_display()
+ * makes resource 1 (B8G8R8X8, what iOS draws) backed by contiguous guest memory and puts it on
+ * scanout 0, and after every frame hakios_vgpu_flush() sends TRANSFER_TO_HOST_2D and
+ * RESOURCE_FLUSH.
+ *
+ * For 3D on top (bsd/dev/hakios.vgpu3d.c): the 2D driver negotiates VIRTIO_GPU_F_VIRGL and
+ * VIRTIO_GPU_F_CONTEXT_INIT when offered (it doesn't change 2D), keeps resource IDs below
+ * HAKIOS_VGPU_3D_FIRST_ID, and lets anyone put one command at a time on the control queue
+ * through hakios_vgpu_ctrl().
+ */
+#ifndef _SYS_HAKIOS_VGPU_H_
+#define _SYS_HAKIOS_VGPU_H_
+
+#include <stdint.h>
+#include <sys/cdefs.h>
+
+__BEGIN_DECLS
+
+#define VIRTIO_GPU_F_VIRGL              0
+#define VIRTIO_GPU_F_EDID               1
+#define VIRTIO_GPU_F_RESOURCE_UUID      2
+#define VIRTIO_GPU_F_RESOURCE_BLOB      3
+#define VIRTIO_GPU_F_CONTEXT_INIT       4
+
+#define HAKIOS_VGPU_2D_RESOURCE        1               /* the scanout's */
+#define HAKIOS_VGPU_3D_FIRST_ID        0x10000         /* 3D allocates from here up */
+#define HAKIOS_VGPU_CTRL_MAX           65536           /* largest command for hakios_vgpu_ctrl */
+#define HAKIOS_VGPU_RESP_MAX           4096            /* largest response */
+
+/*
+ * The scanout, set up on first call: its memory (kernel address), size and bytes per row.
+ * 0, ENODEV (no virtio-gpu or no virtio core), ENOMEM, or EIO (the device said no).
+ */
+int hakios_vgpu_display(void **fb, uint32_t *width, uint32_t *height, uint32_t *stride);
+/* The rectangle changed: copy it to the host's resource and show it. 0 or EIO. */
+int hakios_vgpu_flush(uint32_t x, uint32_t y, uint32_t width, uint32_t height);
+/*
+ * One command on the control queue, waited for: cmd (starting with struct virtio_gpu_ctrl_hdr)
+ * is copied to device-visible memory, the response (resp_len bytes at most) back. Serialized
+ * with the 2D driver's own commands; may sleep. 0, EINVAL (too long), ENODEV, or ETIMEDOUT.
+ */
+int hakios_vgpu_ctrl(const void *cmd, uint32_t cmd_len, void *resp, uint32_t resp_len);
+/* Device features negotiated (VIRTIO_GPU_F_* bits); 0 before the device is set up. */
+uint64_t hakios_vgpu_features(void);
+
+__END_DECLS
+
+#endif /* _SYS_HAKIOS_VGPU_H_ */
diff --git a/bsd/sys/hakios.vgpu3d.h b/bsd/sys/hakios.vgpu3d.h
new file mode 100644
index 0000000000000000000000000000000000000000..66b5cdc8b7bc67e0beb134c68c92d28f38510ce3
--- /dev/null
+++ b/bsd/sys/hakios.vgpu3d.h
@@ -0,0 +1,349 @@
+/*
+ * virtio-gpu 3D for the window server: the guest half of the paravirtual GPU path
+ * (scion docs/GPU.md, path B). The host half is crosvm's virtio-gpu with the gfxstream
+ * renderer, which is what the Android Virtualization Framework ships on the Pixel 10. It
+ * draws with the phone's own GPU driver (the PowerVR's OpenGL ES through EGL, or Vulkan).
+ *
+ * This layer covers:
+ *   - the virtio-gpu 3D commands (capsets, CTX_CREATE, RESOURCE_CREATE_3D, ATTACH_BACKING,
+ *     CTX_ATTACH_RESOURCE, TRANSFER_{TO,FROM}_HOST_3D, SET_SCANOUT, RESOURCE_FLUSH);
+ *   - gfxstream's "pipe" transport: a PIPE_BUFFER resource with bind VIRGL_BIND_CUSTOM is a
+ *     byte stream to a render thread on the host. The first write names the service
+ *     ("pipe:opengles"), and replies come back through TRANSFER_FROM_HOST_3D;
+ *   - the wire encoding of the renderControl (rc*, EGL-ish) and OpenGL ES 2 calls this needs.
+ *     These are the encodings of gfxstream's generated encoders (guest/renderControl_enc,
+ *     guest/GLESv2_enc): [opcode u32][packet size u32][arguments]. A buffer the host fills
+ *     is sent as its size only, and replies are the out-buffers, then the return value.
+ *
+ * It sits on one function, ops->ctrl, which submits one control-queue command and waits for
+ * the reply. The device and its queues belong to the virtio-gpu driver (2D display, agent D's
+ * hakios_virtio_gpu), and this file never touches them. The bare-metal AVF test guest
+ * (avf/gpu3d/probe) provides its own ctrl. Plain C with no allocation and no floating point
+ * (GL floats are passed as IEEE-754 bit patterns, VGPU3D_F_*), so it builds into the kernel
+ * and into the freestanding probe alike.
+ *
+ * Resource IDs 0x10000 and up belong to this layer; the 2D driver keeps those below.
+ */
+#ifndef _SYS_HAKIOS_VGPU3D_H_
+#define _SYS_HAKIOS_VGPU3D_H_
+
+#include <stdint.h>
+#include <stddef.h>
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* ---- virtio-gpu (virtio 1.2, section 5.7) ---------------------------------------------- */
+
+#define VIRTIO_GPU_F_VIRGL              0
+#define VIRTIO_GPU_F_EDID               1
+#define VIRTIO_GPU_F_RESOURCE_UUID      2
+#define VIRTIO_GPU_F_RESOURCE_BLOB      3
+#define VIRTIO_GPU_F_CONTEXT_INIT       4
+
+enum {
+	VIRTIO_GPU_CMD_GET_DISPLAY_INFO = 0x0100,
+	VIRTIO_GPU_CMD_RESOURCE_CREATE_2D,
+	VIRTIO_GPU_CMD_RESOURCE_UNREF,
+	VIRTIO_GPU_CMD_SET_SCANOUT,
+	VIRTIO_GPU_CMD_RESOURCE_FLUSH,
+	VIRTIO_GPU_CMD_TRANSFER_TO_HOST_2D,
+	VIRTIO_GPU_CMD_RESOURCE_ATTACH_BACKING,
+	VIRTIO_GPU_CMD_RESOURCE_DETACH_BACKING,
+	VIRTIO_GPU_CMD_GET_CAPSET_INFO,
+	VIRTIO_GPU_CMD_GET_CAPSET,
+	VIRTIO_GPU_CMD_GET_EDID,
+	VIRTIO_GPU_CMD_RESOURCE_ASSIGN_UUID,
+	VIRTIO_GPU_CMD_RESOURCE_CREATE_BLOB,
+	VIRTIO_GPU_CMD_SET_SCANOUT_BLOB,
+
+	VIRTIO_GPU_CMD_CTX_CREATE = 0x0200,
+	VIRTIO_GPU_CMD_CTX_DESTROY,
+	VIRTIO_GPU_CMD_CTX_ATTACH_RESOURCE,
+	VIRTIO_GPU_CMD_CTX_DETACH_RESOURCE,
+	VIRTIO_GPU_CMD_RESOURCE_CREATE_3D,
+	VIRTIO_GPU_CMD_TRANSFER_TO_HOST_3D,
+	VIRTIO_GPU_CMD_TRANSFER_FROM_HOST_3D,
+	VIRTIO_GPU_CMD_SUBMIT_3D,
+	VIRTIO_GPU_CMD_RESOURCE_MAP_BLOB,
+	VIRTIO_GPU_CMD_RESOURCE_UNMAP_BLOB,
+
+	VIRTIO_GPU_RESP_OK_NODATA = 0x1100,
+	VIRTIO_GPU_RESP_OK_DISPLAY_INFO,
+	VIRTIO_GPU_RESP_OK_CAPSET_INFO,
+	VIRTIO_GPU_RESP_OK_CAPSET,
+	VIRTIO_GPU_RESP_OK_EDID,
+	VIRTIO_GPU_RESP_OK_RESOURCE_UUID,
+	VIRTIO_GPU_RESP_OK_MAP_INFO,
+
+	VIRTIO_GPU_RESP_ERR_UNSPEC = 0x1200,
+};
+
+#define VIRTIO_GPU_FLAG_FENCE           (1u << 0)
+#define VIRTIO_GPU_FLAG_INFO_RING_IDX   (1u << 1)
+
+struct virtio_gpu_ctrl_hdr {
+	uint32_t type;
+	uint32_t flags;
+	uint64_t fence_id;
+	uint32_t ctx_id;
+	uint8_t  ring_idx;
+	uint8_t  padding[3];
+};
+
+struct virtio_gpu_config {
+	uint32_t events_read;
+	uint32_t events_clear;
+	uint32_t num_scanouts;
+	uint32_t num_capsets;
+};
+
+struct virtio_gpu_rect { uint32_t x, y, width, height; };
+struct virtio_gpu_box { uint32_t x, y, z, w, h, d; };
+
+#define VIRTIO_GPU_MAX_SCANOUTS 16
+struct virtio_gpu_resp_display_info {
+	struct virtio_gpu_ctrl_hdr hdr;
+	struct { struct virtio_gpu_rect r; uint32_t enabled, flags; } pmodes[VIRTIO_GPU_MAX_SCANOUTS];
+};
+
+struct virtio_gpu_get_capset_info { struct virtio_gpu_ctrl_hdr hdr; uint32_t capset_index, padding; };
+struct virtio_gpu_resp_capset_info {
+	struct virtio_gpu_ctrl_hdr hdr;
+	uint32_t capset_id, capset_max_version, capset_max_size, padding;
+};
+struct virtio_gpu_get_capset { struct virtio_gpu_ctrl_hdr hdr; uint32_t capset_id, capset_version; };
+
+/* context_init: low 8 bits are the capset ID (VIRTIO_GPU_F_CONTEXT_INIT) */
+struct virtio_gpu_ctx_create {
+	struct virtio_gpu_ctrl_hdr hdr;
+	uint32_t nlen, context_init;
+	char debug_name[64];
+};
+struct virtio_gpu_ctx_resource { struct virtio_gpu_ctrl_hdr hdr; uint32_t resource_id, padding; };
+
+struct virtio_gpu_resource_create_3d {
+	struct virtio_gpu_ctrl_hdr hdr;
+	uint32_t resource_id, target, format, bind, width, height, depth;
+	uint32_t array_size, last_level, nr_samples, flags, padding;
+};
+struct virtio_gpu_mem_entry { uint64_t addr; uint32_t length, padding; };
+struct virtio_gpu_resource_attach_backing {
+	struct virtio_gpu_ctrl_hdr hdr;
+	uint32_t resource_id, nr_entries;
+	struct virtio_gpu_mem_entry entry[1];   /* one physically contiguous range here */
+};
+struct virtio_gpu_resource_unref { struct virtio_gpu_ctrl_hdr hdr; uint32_t resource_id, padding; };
+struct virtio_gpu_transfer_host_3d {
+	struct virtio_gpu_ctrl_hdr hdr;
+	struct virtio_gpu_box box;
+	uint64_t offset;
+	uint32_t resource_id, level, stride, layer_stride;
+};
+struct virtio_gpu_set_scanout {
+	struct virtio_gpu_ctrl_hdr hdr;
+	struct virtio_gpu_rect r;
+	uint32_t scanout_id, resource_id;
+};
+struct virtio_gpu_resource_flush {
+	struct virtio_gpu_ctrl_hdr hdr;
+	struct virtio_gpu_rect r;
+	uint32_t resource_id, padding;
+};
+
+/* capset IDs (rutabaga_gfx_ffi.h) */
+#define VIRTIO_GPU_CAPSET_VIRGL                 1
+#define VIRTIO_GPU_CAPSET_VIRGL2                2
+#define VIRTIO_GPU_CAPSET_GFXSTREAM_VULKAN      3
+#define VIRTIO_GPU_CAPSET_VENUS                 4
+#define VIRTIO_GPU_CAPSET_CROSS_DOMAIN          5
+#define VIRTIO_GPU_CAPSET_DRM                   6
+#define VIRTIO_GPU_CAPSET_GFXSTREAM_MAGMA       7
+#define VIRTIO_GPU_CAPSET_GFXSTREAM_GLES        8
+#define VIRTIO_GPU_CAPSET_GFXSTREAM_COMPOSER    9
+
+/* gallium targets, virgl formats and binds as gfxstream reads them */
+#define VGPU3D_PIPE_BUFFER              0
+#define VGPU3D_PIPE_TEXTURE_2D          2
+#define VIRGL_FORMAT_B8G8R8A8_UNORM     1
+#define VIRGL_FORMAT_R8_UNORM           64
+#define VIRGL_FORMAT_R8G8B8A8_UNORM     67
+#define VIRGL_BIND_RENDER_TARGET        (1u << 1)
+#define VIRGL_BIND_SAMPLER_VIEW         (1u << 3)
+#define VIRGL_BIND_CUSTOM               (1u << 17)
+#define VIRGL_BIND_SCANOUT              (1u << 18)
+
+/* ---- what the layer needs from its host ------------------------------------------------ */
+
+struct vgpu3d_ops {
+	void *arg;
+	/*
+	 * Submit cmd on the control queue and wait for the device's reply in resp. 0 when the
+	 * device answered (the reply type is checked here), an errno when the transport failed or
+	 * timed out. Must serialize with every other user of the control queue.
+	 */
+	int (*ctrl)(void *arg, const void *cmd, uint32_t cmd_len, void *resp, uint32_t resp_len);
+	/* Zeroed, physically contiguous, CPU-visible memory the device can read and write. */
+	void *(*dma_alloc)(void *arg, size_t size, uint64_t *pa);
+	/* One line of log, without the newline. */
+	void (*log)(void *arg, const char *line);
+	/* A monotonic clock, for the self-test's timings. */
+	uint64_t (*now_ns)(void *arg);
+	/*
+	 * Optional: send cmd without waiting for its reply, in order with everything sent before and
+	 * after (SCGPU's ring). 0 when it was sent; anything else and ctrl() is used instead.
+	 */
+	int (*post)(void *arg, const void *cmd, uint32_t cmd_len);
+};
+
+#define VGPU3D_MAX_CAPSETS      16
+#define VGPU3D_FIRST_RESOURCE   0x10000u
+
+struct vgpu3d {
+	struct vgpu3d_ops ops;
+	uint64_t features;                      /* negotiated virtio-gpu features */
+	uint32_t num_capsets;
+	struct { uint32_t id, max_version, max_size; } capset[VGPU3D_MAX_CAPSETS];
+	uint32_t gles_capset[4];                /* gfxstream glesCapset: version, ring, buffer, align */
+
+	uint32_t ctx_id;                        /* virtio-gpu context of the pipe, 0 = none */
+	uint32_t ctx_capset;
+	uint32_t next_resource;
+	uint32_t pipe_res;                      /* the PIPE_BUFFER resource */
+	uint8_t *pipe_va;                       /* its backing: the staging buffer of both directions */
+	uint64_t pipe_pa;
+	uint32_t pipe_size;
+	uint32_t wpos;                          /* bytes encoded and not yet sent */
+	int err;                                /* first error; every later call is a no-op */
+	uint64_t bytes_out, bytes_in, transfers;
+};
+
+/* ---- the layer ------------------------------------------------------------------------- */
+
+/* printf-like line through ops->log (%s %c %d %u %x %p with l/ll and a 0-padded width) */
+void vgpu3d_log(struct vgpu3d *g, const char *fmt, ...) __attribute__((format(printf, 2, 3)));
+
+/*
+ * Lists the capsets (GET_CAPSET_INFO 0..num_capsets-1; VGPU3D_PROBE_CAPSETS: until the device
+ * refuses one) and reads gfxstream-gles's. 0 or errno.
+ */
+#define VGPU3D_PROBE_CAPSETS    0xffffffffu
+int vgpu3d_query(struct vgpu3d *g, uint64_t features, uint32_t num_capsets);
+/* The capset is offered (by ID). */
+bool vgpu3d_has_capset(const struct vgpu3d *g, uint32_t id);
+/*
+ * Creates a context of this capset (0 = the host's default) and the pipe, and connects it
+ * to "pipe:opengles": a render thread on the host, decoding renderControl and GLES. 0 or errno.
+ */
+int vgpu3d_open(struct vgpu3d *g, uint32_t capset, uint32_t pipe_size);
+/* A 2D RGBA host colour buffer as a resource (RESOURCE_CREATE_3D), for scanout; 0 on failure. */
+uint32_t vgpu3d_create_scanout_resource(struct vgpu3d *g, uint32_t width, uint32_t height);
+/* SET_SCANOUT + RESOURCE_FLUSH of a whole resource. */
+int vgpu3d_present(struct vgpu3d *g, uint32_t scanout, uint32_t res, uint32_t width, uint32_t height);
+
+/*
+ * A 2D resource of this context (RESOURCE_CREATE_3D + ATTACH_BACKING + CTX_ATTACH_RESOURCE) with
+ * the given backing pages; gfxstream makes it a colour buffer whose handle is `res`. scratch
+ * holds the ATTACH_BACKING command. 0 or errno.
+ */
+int vgpu3d_resource_create(struct vgpu3d *g, uint32_t res, uint32_t width, uint32_t height, uint32_t format,
+    uint32_t bind, const struct virtio_gpu_mem_entry *entries, uint32_t nentries, void *scratch, uint32_t scratch_size);
+int vgpu3d_resource_unref(struct vgpu3d *g, uint32_t res);
+/* TRANSFER_{TO,FROM}_HOST_3D of a box; the backing is width * 4 bytes a row (gfxstream's layout). */
+int vgpu3d_transfer_box(struct vgpu3d *g, uint32_t res, bool to_host, uint32_t x, uint32_t y, uint32_t w,
+    uint32_t h, uint64_t offset);
+/* The pipe and the context away. */
+void vgpu3d_close(struct vgpu3d *g);
+
+/* The stream: space for n bytes of encoded calls, sending what is queued when it is full. */
+uint8_t *vgpu3d_alloc(struct vgpu3d *g, uint32_t n);
+/* Send what is queued (TRANSFER_TO_HOST_3D). */
+int vgpu3d_flush(struct vgpu3d *g);
+/* Send, then read exactly n bytes of replies (TRANSFER_FROM_HOST_3D, in pipe-sized pieces). */
+int vgpu3d_read(struct vgpu3d *g, void *buf, uint32_t n);
+
+/* ---- renderControl and GLES 2, as gfxstream encodes them (return 0 / the host's value) -- */
+
+uint32_t rc_get_renderer_version(struct vgpu3d *g);
+int32_t  rc_get_gl_string(struct vgpu3d *g, uint32_t name, char *buf, uint32_t size);
+int32_t  rc_choose_config(struct vgpu3d *g, const int32_t *attribs, uint32_t attribs_bytes,
+			  uint32_t *configs, uint32_t nconfigs);
+uint32_t rc_create_context(struct vgpu3d *g, uint32_t config, uint32_t share, uint32_t gles_api);
+uint32_t rc_create_window_surface(struct vgpu3d *g, uint32_t config, uint32_t w, uint32_t h);
+uint32_t rc_create_color_buffer(struct vgpu3d *g, uint32_t w, uint32_t h, uint32_t internal_format);
+void     rc_set_window_color_buffer(struct vgpu3d *g, uint32_t surface, uint32_t color_buffer);
+int32_t  rc_make_current(struct vgpu3d *g, uint32_t ctx, uint32_t draw, uint32_t read);
+int32_t  rc_flush_window_color_buffer(struct vgpu3d *g, uint32_t surface);
+int      rc_read_color_buffer(struct vgpu3d *g, uint32_t cb, uint32_t x, uint32_t y, uint32_t w,
+			      uint32_t h, void *pixels);   /* GL_RGBA, GL_UNSIGNED_BYTE */
+
+void gl_viewport(struct vgpu3d *g, int32_t x, int32_t y, int32_t w, int32_t h);
+void gl_clear_color(struct vgpu3d *g, uint32_t r, uint32_t gr, uint32_t b, uint32_t a); /* VGPU3D_F_* */
+void gl_clear(struct vgpu3d *g, uint32_t mask);
+void gl_enable(struct vgpu3d *g, uint32_t cap);
+void gl_disable(struct vgpu3d *g, uint32_t cap);
+void gl_scissor(struct vgpu3d *g, int32_t x, int32_t y, int32_t w, int32_t h);
+void gl_finish(struct vgpu3d *g);
+uint32_t gl_get_error(struct vgpu3d *g);
+uint32_t gl_create_shader(struct vgpu3d *g, uint32_t type);
+void gl_shader_string(struct vgpu3d *g, uint32_t shader, const char *src);
+void gl_compile_shader(struct vgpu3d *g, uint32_t shader);
+int32_t gl_get_shaderiv(struct vgpu3d *g, uint32_t shader, uint32_t pname);
+uint32_t gl_create_program(struct vgpu3d *g);
+void gl_attach_shader(struct vgpu3d *g, uint32_t program, uint32_t shader);
+void gl_bind_attrib_location(struct vgpu3d *g, uint32_t program, uint32_t index, const char *name);
+void gl_link_program(struct vgpu3d *g, uint32_t program);
+int32_t gl_get_programiv(struct vgpu3d *g, uint32_t program, uint32_t pname);
+void gl_use_program(struct vgpu3d *g, uint32_t program);
+void gl_vertex_attrib_pointer_data(struct vgpu3d *g, uint32_t index, int32_t size, uint32_t type,
+				   bool normalized, int32_t stride, const void *data, uint32_t len);
+void gl_enable_vertex_attrib_array(struct vgpu3d *g, uint32_t index);
+void gl_draw_arrays(struct vgpu3d *g, uint32_t mode, int32_t first, int32_t count);
+void gl_gen_textures(struct vgpu3d *g, uint32_t n, uint32_t *textures);
+void gl_bind_texture(struct vgpu3d *g, uint32_t target, uint32_t texture);
+void gl_tex_parameteri(struct vgpu3d *g, uint32_t target, uint32_t pname, int32_t param);
+/* GL_RGBA / GL_UNSIGNED_BYTE, rows packed (width * 4 bytes, the default unpack alignment) */
+void gl_tex_image_2d_rgba(struct vgpu3d *g, uint32_t target, int32_t level, int32_t w, int32_t h,
+			  const void *pixels);
+void gl_blend_func(struct vgpu3d *g, uint32_t sfactor, uint32_t dfactor);
+void gl_active_texture(struct vgpu3d *g, uint32_t unit);
+
+/* ---- the self-test: bring-up, a picture drawn by the host GPU, timings ----------------- */
+
+struct vgpu3d_selftest {
+	uint32_t width, height;                 /* in: the picture's size */
+	uint8_t *pixels;                        /* in: width * height * 4 bytes, for the readback */
+	uint32_t scanout_res;                   /* in: draw into this resource as well (0 = none) */
+	/* out */
+	uint32_t context, surface, color_buffer;        /* left current, for more drawing */
+	char vendor[96], renderer[160], version[96];
+	uint32_t renderer_version;
+	uint32_t checks_passed, checks_total;
+	uint32_t fnv;                           /* FNV-1a of the readback */
+	bool rows_top_down;                     /* readback row 0 is the top of the picture */
+	uint64_t rtt_ns;                        /* one round trip (rcGetRendererVersion) */
+	uint64_t frame_ns;                      /* clear + 3 scissor clears + a triangle + flush */
+	uint64_t readback_ns;                   /* the whole picture back into the guest */
+};
+int vgpu3d_selftest(struct vgpu3d *g, struct vgpu3d_selftest *t);
+
+/* IEEE-754 single bit patterns for GL calls */
+#define VGPU3D_F_0      0x00000000u
+#define VGPU3D_F_0_1    0x3dcccccdu
+#define VGPU3D_F_0_2    0x3e4ccccdu
+#define VGPU3D_F_0_25   0x3e800000u
+#define VGPU3D_F_0_5    0x3f000000u
+#define VGPU3D_F_0_75   0x3f400000u
+#define VGPU3D_F_0_8    0x3f4ccccdu
+#define VGPU3D_F_1      0x3f800000u
+#define VGPU3D_F_M0_5   0xbf000000u
+#define VGPU3D_F_M0_75  0xbf400000u
+#define VGPU3D_F_M1     0xbf800000u
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* _SYS_HAKIOS_VGPU3D_H_ */
diff --git a/bsd/sys/hakios.virtio.h b/bsd/sys/hakios.virtio.h
new file mode 100644
index 0000000000000000000000000000000000000000..5c3d16d0508239e5c4cd1e6141df3f0fb92f3ba6
--- /dev/null
+++ b/bsd/sys/hakios.virtio.h
@@ -0,0 +1,197 @@
+/*
+ * Virtio for the kernel's own drivers, over either transport:
+ *
+ *   - virtio-pci 1.x ("modern"), on the PCI host bridge of sys/hakios.pci.h: what crosvm
+ *     (the Android Virtualization Framework) offers, and QEMU with -device virtio-*-pci;
+ *   - virtio-mmio version 2, QEMU virt's 32 transports at 0x0a000000 (-device virtio-*-device,
+ *     -global virtio-mmio.force-legacy=false). That bus address means nothing anywhere else, so
+ *     it is only looked at with boot-arg virtio_mmio=1 (or one of the old per-driver boot-args
+ *     virtio_blk=1, virtio_input=1, virtio_net=1, virtio_sound=1).
+ *
+ * The drivers (hakios_virtio_{blk,net,input,sound,console}.c) see one interface: feature
+ * negotiation, split virtqueues, the device's configuration space, and interrupts or polling.
+ * Implementation: bsd/dev/hakios.virtio.c.
+ *
+ * A driver, in short (hakios.virtio_blk.c is a complete one):
+ *
+ *   vio_dev_t *d = vio_find(VIRTIO_ID_BLOCK, 0);          // the first block device, any transport
+ *   uint64_t features;
+ *   vio_init(d, WANTED_FEATURES, &features);              // reset, ACK, DRIVER, FEATURES_OK
+ *   vio_queue_t *q;
+ *   vio_queue_setup(d, 0, 0, &q);                         // rings in contiguous kernel memory
+ *   vio_intr_enable(d);                                   // optional: wakes vio_intr_wait
+ *   vio_driver_ok(d);
+ *   ...
+ *   struct vio_sg sg[] = { { hdr_pa, 16, false }, { data_pa, n, true }, { status_pa, 1, true } };
+ *   uint32_t seq = vio_intr_seq(d);
+ *   vio_queue_add(q, sg, 3, cookie);
+ *   vio_queue_kick(q);
+ *   while ((c = vio_queue_get(q, &len)) == NULL) {
+ *           vio_intr_wait(d, seq, 10 * NSEC_PER_MSEC);     // sleeps; polls when it cannot
+ *           seq = vio_intr_seq(d);
+ *   }
+ *
+ * Devices whose events come on their own (input, a GPU's cursor and fence completions) can
+ * have vio_service_start() call them back from a kernel thread after every interrupt and at
+ * least every poll_ns, never in interrupt context.
+ *
+ * Locking: queues are not locked here. A driver serializes all use of one queue (one mutex
+ * per queue, or a single thread). Everything up to vio_driver_ok and the queue operations
+ * work before the VM is up when the rings come from vio_queue_setup_mem (the console does that
+ * from serial_init); vio_queue_setup, vio_dma_alloc, interrupts and sleeping waits need a
+ * running kernel.
+ *
+ * DMA: guest physical addresses, no IOMMU. VIRTIO_F_ACCESS_PLATFORM is accepted when offered
+ * (crosvm offers it for protected VMs), on the assumption that the platform's mapping is the
+ * identity. Memory is normal cacheable memory: virtio devices of QEMU and crosvm are coherent.
+ */
+#ifndef _SYS_HAKIOS_VIRTIO_H_
+#define _SYS_HAKIOS_VIRTIO_H_
+
+#include <stdint.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <sys/cdefs.h>
+
+__BEGIN_DECLS
+
+/* Device types (virtio 1.2, section 5) */
+#define VIRTIO_ID_NET           1
+#define VIRTIO_ID_BLOCK         2
+#define VIRTIO_ID_CONSOLE       3
+#define VIRTIO_ID_RNG           4
+#define VIRTIO_ID_GPU           16
+#define VIRTIO_ID_INPUT         18
+#define VIRTIO_ID_VSOCK         19
+#define VIRTIO_ID_SOUND         25
+
+/* Transport feature bits; the device's own are below 24 */
+#define VIRTIO_F_INDIRECT_DESC  28
+#define VIRTIO_F_EVENT_IDX      29
+#define VIRTIO_F_VERSION_1      32      /* always negotiated: legacy devices are not driven */
+#define VIRTIO_F_ACCESS_PLATFORM 33     /* accepted when offered */
+#define VIRTIO_F_RING_PACKED    34
+#define VIRTIO_BIT(b)           (1ull << (b))
+
+/* device_status */
+#define VIRTIO_STATUS_ACKNOWLEDGE       0x01
+#define VIRTIO_STATUS_DRIVER            0x02
+#define VIRTIO_STATUS_DRIVER_OK         0x04
+#define VIRTIO_STATUS_FEATURES_OK       0x08
+#define VIRTIO_STATUS_NEEDS_RESET       0x40
+#define VIRTIO_STATUS_FAILED            0x80
+
+/* interrupt status bits */
+#define VIRTIO_ISR_QUEUE        0x1
+#define VIRTIO_ISR_CONFIG       0x2
+
+#define VIO_TRANSPORT_PCI       1
+#define VIO_TRANSPORT_MMIO      2
+
+typedef struct vio_dev vio_dev_t;
+typedef struct vio_queue vio_queue_t;
+
+/* One buffer of a descriptor chain: read by the device (write = false) or written by it. */
+struct vio_sg {
+	uint64_t        pa;
+	uint32_t        len;
+	bool            write;
+};
+
+/*
+ * The nth (from 0) device of this type: PCI devices first, in enumeration order, then
+ * virtio-mmio slots if that bus is enabled. A device the firmware still uses (the loader's own
+ * disk under UEFI) is skipped. NULL if there is none. The first call enumerates.
+ */
+vio_dev_t *vio_find(uint32_t type, unsigned nth);
+uint32_t vio_type(vio_dev_t *d);
+int vio_transport(vio_dev_t *d);
+/* "pci 00:02.0" or "mmio slot 31", for messages */
+const char *vio_name(vio_dev_t *d);
+/* The PCI function, NULL for virtio-mmio. */
+const struct hakios_pci_dev *vio_pci(vio_dev_t *d);
+
+/*
+ * Reset, ACKNOWLEDGE | DRIVER, accept offered & (want | VERSION_1 | ACCESS_PLATFORM),
+ * FEATURES_OK. 0, or ENOTSUP when the device lacks VERSION_1 or refuses FEATURES_OK.
+ */
+int vio_init(vio_dev_t *d, uint64_t want, uint64_t *negotiated);
+uint64_t vio_device_features(vio_dev_t *d);
+uint64_t vio_features(vio_dev_t *d);   /* negotiated */
+void vio_driver_ok(vio_dev_t *d);
+void vio_fail(vio_dev_t *d);
+void vio_reset(vio_dev_t *d);
+uint8_t vio_status(vio_dev_t *d);
+uint16_t vio_num_queues(vio_dev_t *d);         /* PCI: num_queues; mmio: probed, at most 16 */
+
+/* The device-specific configuration space; a read is consistent (config generation). */
+uint8_t  vio_cfg_read8(vio_dev_t *d, uint32_t off);
+uint16_t vio_cfg_read16(vio_dev_t *d, uint32_t off);
+uint32_t vio_cfg_read32(vio_dev_t *d, uint32_t off);
+uint64_t vio_cfg_read64(vio_dev_t *d, uint32_t off);
+void vio_cfg_read(vio_dev_t *d, uint32_t off, void *buf, uint32_t len);
+void vio_cfg_write8(vio_dev_t *d, uint32_t off, uint8_t v);
+void vio_cfg_write16(vio_dev_t *d, uint32_t off, uint16_t v);
+void vio_cfg_write32(vio_dev_t *d, uint32_t off, uint32_t v);
+
+/*
+ * Queue 'index', between vio_init and vio_driver_ok. size 0 = the device's maximum, at most
+ * 256; otherwise the largest power of two <= min(size, maximum). vio_queue_setup allocates the
+ * rings (vio_dma_alloc); vio_queue_setup_mem takes vio_queue_mem_size(size) bytes of zeroed,
+ * 4 KB-aligned memory at physical address pa (static memory for early users).
+ * 0, ENOENT (no such queue) or ENOMEM.
+ */
+int vio_queue_setup(vio_dev_t *d, uint16_t index, uint16_t size, vio_queue_t **out);
+size_t vio_queue_mem_size(uint16_t size);
+int vio_queue_setup_mem(vio_dev_t *d, uint16_t index, uint16_t size, void *mem, uint64_t pa, vio_queue_t **out);
+uint16_t vio_queue_size(vio_queue_t *q);
+uint16_t vio_queue_num_free(vio_queue_t *q);
+vio_dev_t *vio_queue_dev(vio_queue_t *q);
+
+/*
+ * Put a chain of n buffers (the device-readable ones first) on the queue under a non-NULL
+ * cookie. The device sees it after vio_queue_kick. 0, or ENOSPC with fewer than n free
+ * descriptors.
+ */
+int vio_queue_add(vio_queue_t *q, const struct vio_sg *sg, unsigned n, void *cookie);
+/* Publish what was added and notify the device, unless it asked not to be. */
+void vio_queue_kick(vio_queue_t *q);
+/* The cookie of the next chain the device is done with (and the bytes it wrote), or NULL. */
+void *vio_queue_get(vio_queue_t *q, uint32_t *len);
+/* Ask the device not to interrupt for this queue (a hint: VIRTQ_AVAIL_F_NO_INTERRUPT). */
+void vio_queue_intr(vio_queue_t *q, bool enable);
+
+/*
+ * Interrupts: the device's INTx line (PCI) or its SPI (virtio-mmio) through
+ * gic_v3_spi_attach(). The handler reads and acknowledges the interrupt status, adds it to the
+ * device's pending bits, bumps vio_intr_seq and wakes vio_intr_wait. ENXIO when there is no
+ * line, ENOTSUP with boot-arg virtio_poll=1: the driver then polls (vio_intr_wait still works,
+ * it just sleeps out its timeout).
+ */
+int vio_intr_enable(vio_dev_t *d);
+bool vio_intr_active(vio_dev_t *d);
+uint32_t vio_intr_seq(vio_dev_t *d);
+uint8_t vio_intr_isr(vio_dev_t *d);    /* take and clear the pending bits */
+/*
+ * Until vio_intr_seq(d) != seq or timeout_ns has passed; true if an interrupt came. Where it
+ * cannot block (interrupts off, preemption disabled, before threads) it spins.
+ */
+bool vio_intr_wait(vio_dev_t *d, uint32_t seq, uint64_t timeout_ns);
+
+/* A kernel thread calling cb(arg, isr) after each interrupt and at least every poll_ns (isr 0). */
+typedef void (*vio_service_fn)(void *arg, uint8_t isr);
+int vio_service_start(vio_dev_t *d, vio_service_fn cb, void *arg, uint64_t poll_ns);
+
+/*
+ * A shared memory region of the device (virtio-pci capability type 8, e.g. virtio-gpu's
+ * host-visible memory, shmid 1): its CPU physical address and length. ENOENT when the device
+ * has none with that id (and always on virtio-mmio, which is not looked at for them).
+ */
+int vio_shm_region(vio_dev_t *d, uint8_t id, uint64_t *pa, uint64_t *len);
+
+/* Physically contiguous, zeroed, page-aligned wired memory; NULL on failure. Never freed. */
+void *vio_dma_alloc(size_t size, uint64_t *pa);
+
+__END_DECLS
+
+#endif /* _SYS_HAKIOS_VIRTIO_H_ */
diff --git a/bsd/sys/hakios.virtio_blk.h b/bsd/sys/hakios.virtio_blk.h
new file mode 100644
index 0000000000000000000000000000000000000000..b0a7e914fc4c97f6c194553be2edc4d68ef0e3f4
--- /dev/null
+++ b/bsd/sys/hakios.virtio_blk.h
@@ -0,0 +1,22 @@
+/*
+ * Virtio block devices: disk images of the host become /dev/rvblkN (and the character
+ * devices /dev/rrvblkN) in the guest, over virtio-pci or virtio-mmio (sys/hakios.virtio.h).
+ * See bsd/dev/hakios.virtio_blk.c.
+ */
+#ifndef _SYS_HAKIOS_VIRTIO_BLK_H_
+#define _SYS_HAKIOS_VIRTIO_BLK_H_
+
+#include <stdbool.h>
+#include <sys/types.h>
+#include <sys/cdefs.h>
+
+__BEGIN_DECLS
+void hakios_virtio_blk_init(void);       /* idempotent */
+bool hakios_virtio_blk_dev(dev_t dev);    /* one of its devices */
+/* rd=rvblkN: the block device of that disk (initializing the driver), or an errno */
+int hakios_virtio_blk_rootdev(const char *name, dev_t *dev);
+/* /dev/NAME and /dev/rNAME for disk rvblkN as well */
+int hakios_virtio_blk_alias(const char *disk, const char *name);
+__END_DECLS
+
+#endif /* _SYS_HAKIOS_VIRTIO_BLK_H_ */
diff --git a/bsd/sys/hakios.xnu.h b/bsd/sys/hakios.xnu.h
new file mode 100644
