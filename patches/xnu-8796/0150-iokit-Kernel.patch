+static void
+setNumber(OSDictionary * dict, const char * key, uint64_t value)
+{
+	OSNumber * n = OSNumber::withNumber(value, 32);
+
+	if (n != NULL) {
+		dict->setObject(key, n);
+		n->release();
+	}
