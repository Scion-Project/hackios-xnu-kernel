+OSDefineMetaClassAndStructors(IOMobileFramebufferUserClient, IOUserClient);
+
+bool
+IOMobileFramebufferUserClient::initWithTask(task_t owningTask, void * securityID, UInt32 type, OSDictionary * properties)
+{
+	if (!IOUserClient::initWithTask(owningTask, securityID, type, properties)) {
+		return false;
+	}
+	fTask = owningTask;
+	return true;
+}
+
+bool
+IOMobileFramebufferUserClient::start(IOService * provider)
+{
+	fOwner = OSDynamicCast(IOMobileFramebuffer, provider);
+	if (fOwner == NULL || !IOUserClient::start(provider)) {
+		return false;
+	}
+	fLock = IOLockAlloc();
+	fVSyncCall = thread_call_allocate(&IOMobileFramebufferUserClient::vsyncFired, this);
+	return fLock != NULL && fVSyncCall != NULL;
+}
+
+IOReturn
+IOMobileFramebufferUserClient::clientClose(void)
+{
+	if (fLock != NULL) {
+		IOLockLock(fLock);
+		fClosed = true;
+		IOLockUnlock(fLock);
+	}
+	if (fVSyncCall != NULL) {
+		thread_call_cancel_wait(fVSyncCall);
+	}
+	if (!isInactive()) {
+		terminate();
+	}
+	return kIOReturnSuccess;
+}
+
+void
+IOMobileFramebufferUserClient::free(void)
+{
+	if (fVSyncCall != NULL) {
+		thread_call_cancel_wait(fVSyncCall);
+		thread_call_free(fVSyncCall);
+		fVSyncCall = NULL;
+	}
+	for (unsigned i = 0; i < kFBNotifyTypes; i++) {
+		if (fPorts[i] != NULL) {
+			releaseNotificationPort(fPorts[i]);
+			fPorts[i] = NULL;
+		}
+	}
+	if (fLock != NULL) {
+		IOLockFree(fLock);
+		fLock = NULL;
+	}
+	IOUserClient::free();
+}
+
+IOReturn
+IOMobileFramebufferUserClient::registerNotificationPort(mach_port_t port, UInt32 type, io_user_reference_t refCon)
+{
+	mach_port_t old;
+
+	IOLog("MiniIOMobileFramebuffer: notification port for type %u\n", (unsigned) type);
+	if (type >= kFBNotifyTypes) {
+		return kIOReturnBadArgument;
+	}
+	IOLockLock(fLock);
+	old = fPorts[type];
+	fPorts[type] = port;
+	IOLockUnlock(fLock);
+	if (old != NULL) {
+		releaseNotificationPort(old);
+	}
+	return kIOReturnSuccess;
+}
+
+void
+IOMobileFramebufferUserClient::vsyncFired(thread_call_param_t self, thread_call_param_t unused)
+{
+	((IOMobileFramebufferUserClient *) self)->vsync();
+}
+
+/* With the lock held. */
+void
+IOMobileFramebufferUserClient::armVSync(void)
+{
+	uint64_t period, now = mach_absolute_time();
+
+	/* one refresh after the last, not after whenever we got round to this: the rate does not drift */
+	nanoseconds_to_absolutetime(NSEC_PER_SEC / refreshHz(), &period);
+	fVSyncTime += period;
+	if (fVSyncTime <= now || fVSyncTime > now + 2 * period) {
+		fVSyncTime = now + period;
+	}
+	thread_call_enter_delayed(fVSyncCall, fVSyncTime);
+}
+
+/*
+ * One refresh: tell the client, which gets three 64-bit numbers as six 32-bit halves --
+ * the time of this refresh, the same again (the time it was presented), and a counter.
+ */
+void
+IOMobileFramebufferUserClient::vsync(void)
+{
+	OSAsyncReference64 ref;
+	io_user_reference_t args[6];
+	uint64_t now;
+
+	IOLockLock(fLock);
+	now = fVSyncTime;
+	if (fClosed || fCallbacks[kFBNotifyVSync] == 0 || fPorts[kFBNotifyVSync] == NULL) {
+		fVSyncRunning = false;
+	} else {
+		fVSyncCount++;
+		setAsyncReference64(ref, fPorts[kFBNotifyVSync], fCallbacks[kFBNotifyVSync], fRefcons[kFBNotifyVSync], fTask);
+		args[0] = (uint32_t) now;
+		args[1] = now >> 32;
+		args[2] = (uint32_t) now;
+		args[3] = now >> 32;
+		args[4] = (uint32_t) fVSyncCount;
+		args[5] = fVSyncCount >> 32;
+		armVSync();
+		/*
+		 * sent with the lock held: registerNotificationPort() swaps the port under this lock and
+		 * only then lets go of the old one, so the port in `ref` cannot be released while it is sent to
+		 * (the send does not wait: a full queue drops the message)
+		 */
+		IOReturn sent = sendAsyncResult64WithOptions(ref, kIOReturnSuccess, args, 6, kIOUserNotifyOptionCanDrop);
+		if (sent == kIOReturnSuccess) {
+			OSIncrementAtomic(&gVSyncsTold);
+		}
+		if (gTouchLat) {
+			/* "tl: y COUNT due US at US SENT": the refresh told to the window server, when it was due, when it went, and
+			 * whether it went (0) or was dropped on a full queue -- for the window server's idle gaps (tools/frames.py) */
+			hakios_tl("tl: y %llu due %llu at %llu %#x\n", fVSyncCount, micros(now), micros(mach_absolute_time()), sent);
+		}
+	}
+	IOLockUnlock(fLock);
+}
+
+IOReturn
+IOMobileFramebufferUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments * args,
+    IOExternalMethodDispatch * dispatch, OSObject * target, void * reference)
+{
+	const uint64_t * in = args->scalarInput;
+	uint64_t * out = args->scalarOutput;
+	MiniIOSurface * s;
+
+	if (selector < 128 && gFBCalls[selector] < gFBTrace) {
+		char procname[32] = "?";
+
+		gFBCalls[selector]++;
+		proc_selfname(procname, sizeof(procname));
+		IOLog("MiniIOMobileFramebuffer: %s[%d] selector %u (scalars %u in [0x%llx 0x%llx 0x%llx 0x%llx], %u out; "
+		    "structure %u in, %u out)\n", procname, proc_selfpid(), selector, args->scalarInputCount,
+		    args->scalarInputCount > 0 ? in[0] : 0, args->scalarInputCount > 1 ? in[1] : 0,
+		    args->scalarInputCount > 2 ? in[2] : 0, args->scalarInputCount > 3 ? in[3] : 0, args->scalarOutputCount,
+		    args->structureInputSize, args->structureOutputSize);
+	}
+
+	switch (selector) {
+	case kFBMethodGetDisplaySize:                   /* out: width, height */
+		if (args->scalarOutputCount < 2) {
+			return kIOReturnBadArgument;
+		}
+		out[0] = fOwner->fWidth;
+		out[1] = fOwner->fHeight;
+		args->scalarOutputCount = 2;
+		return kIOReturnSuccess;
+
+	case kFBMethodGetID:
+		if (args->scalarOutputCount < 1) {
+			return kIOReturnBadArgument;
+		}
+		out[0] = 1;
+		args->scalarOutputCount = 1;
+		return kIOReturnSuccess;
+
+	case kFBMethodGetDotPitch:                      /* out: pixels per inch */
+		if (args->scalarOutputCount < 1) {
+			return kIOReturnBadArgument;
+		}
+		out[0] = kFBDotsPerInch * fOwner->fWidth / (fOwner->fPointsWide * kFBDefaultScale);
+		args->scalarOutputCount = 1;
+		return kIOReturnSuccess;
+
+	case kFBMethodGetLayerDefaultSurface:           /* in: size wanted (or 0, 0); out: a send right for the surface */
+		if (args->scalarOutputCount < 1) {
+			return kIOReturnBadArgument;
+		}
+		s = fOwner->defaultSurface();
+		if (s == NULL) {
+			return kIOReturnNoMemory;
+		}
+		out[0] = MiniIOSurfaceMakeSendRight(fTask, s);
+		args->scalarOutputCount = 1;
+		return out[0] != 0 ? kIOReturnSuccess : kIOReturnNoMemory;
+
+	case kFBMethodSwapBegin:                        /* out: the number of the new swap */
+		if (args->scalarOutputCount < 1) {
+			return kIOReturnBadArgument;
+		}
+		out[0] = OSIncrementAtomic(&fOwner->fSwapID) + 1;
+		args->scalarOutputCount = 1;
+		return kIOReturnSuccess;
+
+	case kFBMethodSwapEnd:
+		if (args->structureInput == NULL || args->structureInputSize < SWAP_SIZE) {
+			IOLog("MiniIOMobileFramebuffer: swap request of %u bytes, expected %u\n", args->structureInputSize, SWAP_SIZE);
+			return kIOReturnBadArgument;
+		}
+		fOwner->present((const uint8_t *) args->structureInput);
+		return kIOReturnSuccess;
+
+	case kFBMethodSwapWait:                         /* in: the swap; at once, or (fb_swapwait=1) once it is on the panel */
+		if (gTouchLat) {
+			hakios_tl("tl: w %llu %#llx %#llx at %llu\n", args->scalarInputCount > 0 ? in[0] : 0,
+			    args->scalarInputCount > 1 ? in[1] : 0, args->scalarInputCount > 2 ? in[2] : 0, micros(mach_absolute_time()));
+		}
+		fOwner->swapWait(args->scalarInputCount > 0 ? (uint32_t) in[0] : 0);
+		return kIOReturnSuccess;
+	case kFBMethodSwapSignal:
+	case kFBMethodSwapCancel:
+	case kFBMethodSwapCancelAll:
+	case kFBMethodRequestPowerChange:
+	case kFBMethodChangeFrameInfo:
+		return kIOReturnSuccess;
+
+	case kFBMethodNotifications:                    /* in: callback (0 = off), its argument, type, 0 */
+		if (args->scalarInputCount < 3 || in[2] >= kFBNotifyTypes) {
+			return kIOReturnBadArgument;
+		}
+		IOLockLock(fLock);
+		fCallbacks[in[2]] = in[0];
+		fRefcons[in[2]] = in[1];
+		if (in[2] == kFBNotifyVSync && in[0] != 0 && !fVSyncRunning && !fClosed) {
+			fVSyncRunning = true;
+			armVSync();
+		}
+		IOLockUnlock(fLock);
+		return kIOReturnSuccess;
+
+	case kFBMethodSupportedFrameInfo:               /* in: type; out: how many, and their tags: none */
+		if (args->scalarOutputCount >= 1) {
+			out[0] = 0;
+			args->scalarOutputCount = 1;
+		}
+		if (args->structureOutput != NULL) {
+			bzero(args->structureOutput, args->structureOutputSize);
+		}
+		return kIOReturnSuccess;
+
+	case kFBMethodGetBlock:                         /* in: which block; out: its bytes */
+		if (args->structureOutput == NULL) {
+			return kIOReturnBadArgument;
+		}
+		bzero(args->structureOutput, args->structureOutputSize);
+		if (args->scalarInputCount >= 1 && in[0] == 0x40 && args->structureOutputSize >= 12) {
+			/* the current mode: its colour and timing identifiers */
+			uint32_t ids[2] = { kFBColorID, kFBTimingID };
+
+			memcpy((uint8_t *) args->structureOutput + 4, ids, sizeof(ids));
+		}
+		return kIOReturnSuccess;
+
+	case kFBMethodGetCurrentAbsoluteTime:
+		if (args->scalarOutputCount < 1) {
+			return kIOReturnBadArgument;
+		}
+		out[0] = mach_absolute_time();
+		args->scalarOutputCount = 1;
+		return kIOReturnSuccess;
+
+	default:
+		break;
+	}
+
+	if (selector < 128 && !(gFBLogged[selector / 64] & (1ULL << (selector % 64)))) {
+		gFBLogged[selector / 64] |= 1ULL << (selector % 64);
+		IOLog("MiniIOMobileFramebuffer: selector %u not implemented (scalars %u in [0x%llx 0x%llx 0x%llx], %u out; "
+		    "structure %u in, %u out)\n", selector, args->scalarInputCount, args->scalarInputCount > 0 ? in[0] : 0,
+		    args->scalarInputCount > 1 ? in[1] : 0, args->scalarInputCount > 2 ? in[2] : 0, args->scalarOutputCount,
+		    args->structureInputSize, args->structureOutputSize);
+	}
+	/* a request that only sets something is accepted; one that wants an answer gets zeros */
+	if (args->scalarOutputCount != 0) {
+		bzero(out, args->scalarOutputCount * sizeof(out[0]));
+	}
+	if (args->structureOutput != NULL && args->structureOutputSize != 0) {
+		bzero(args->structureOutput, args->structureOutputSize);
+	}
+	return kIOReturnSuccess;
+}
+
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+/*
+ * IOMobileFramebuffer.framework counts the displays it should wait for by looking for
+ * children of /arm-io in the device tree whose device_type is "display-subsystem".
+ */
+static void
+publishDisplayNode(void)
+{
+	IORegistryEntry * armio = IORegistryEntry::fromPath("/arm-io", gIODTPlane);
+	IORegistryEntry * node;
+	OSDictionary * props;
+	OSData * data;
+
+	if (armio == NULL) {
+		IOLog("MiniIOMobileFramebuffer: no /arm-io in the device tree\n");
+		return;
+	}
+	node = OSTypeAlloc(IORegistryEntry);
+	props = OSDictionary::withCapacity(4);
+	if (node != NULL && props != NULL) {
+		data = OSData::withBytes("display-subsystem", sizeof("display-subsystem"));
+		props->setObject("device_type", data);
+		OSSafeReleaseNULL(data);
+		data = OSData::withBytes("redwood,framebuffer", sizeof("redwood,framebuffer"));
+		props->setObject("compatible", data);
+		OSSafeReleaseNULL(data);
+		data = OSData::withBytes("disp0", sizeof("disp0"));
+		props->setObject("name", data);
+		OSSafeReleaseNULL(data);
+		if (node->init(props)) {
+			node->setName("disp0");
+			node->attachToParent(armio, gIODTPlane);
+		}
+	}
+	OSSafeReleaseNULL(props);
+	OSSafeReleaseNULL(node);
+	armio->release();
+}
+
+/*
+ * The graphics accelerator. There is none, but CoreAnimation waits half a minute for a
+ * service of this class to appear before it looks for a GPU at all (once per process). An
+ * accelerator without the properties that name its Metal and OpenGL ES drivers is passed
+ * over by both, which leaves CoreAnimation with its software renderer, as before.
+ *
+ * With boot-arg metal=1 a user process may put those two properties here, which is the whole
+ * of what keeps Metal from finding our driver; see setProperties below, and docs/metal.md 10.31
+ * (10.14 for the measurement that made it a boot-arg).
+ */
+
+/* Metal's step 2 reads exactly these two, in this order, off this service (docs/metal.md 1). */
+#define kAcceleratorPluginNameKey      "MetalPluginName"
+#define kAcceleratorPluginClassNameKey "MetalPluginClassName"
+
+static bool gAcceleratorTakesProperties;        /* boot-arg metal=1 */
+
+class IOAcceleratorES : public IOService
+{
+	OSDeclareDefaultStructors(IOAcceleratorES);
+
+public:
+	virtual IOReturn setProperties(OSObject * properties) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IOAcceleratorES, IOService);
+
+/*
+ * Switch Metal's own device discovery on, from user space: IORegistryEntrySetCFProperties() with
+ * MetalPluginName and MetalPluginClassName. Metal reads the first (getMetalPluginClassForService,
+ * 0x181a39ba4), builds "/System/Library/Extensions/" + it + ".bundle", opens that with NSBundle
+ * and takes the class the second names; with the first missing it returns nil before it even
+ * reads the second, and that single `cbz` is where the chain breaks on this port today.
+ *
+ * This method is the only thing that was in the way. IORegistryEntry::setProperties is
+ * "return kIOReturnUnsupported" (IORegistryEntry.cpp) and IOService does not override it; the
+ * MAC check in front of the call has no policy to ask, because this kernel registers no iokit
+ * hook (bsd/kern/kern_minimac.c); and this service carries no property whitelist.
+ *
+ * Why it is gated on a boot-arg, which is a measured risk and not caution in general
+ * (docs/metal.md 10.14): the conditions Metal puts on a device object are asserts, not soft
+ * refusals (10.2-10.3). A process that asks Metal and is handed a half-made device does not
+ * degrade to another renderer -- it aborts ("Assertion failed: ([self
+ * conformsToProtocol:@protocol(MTLDeviceSPI)])", "failed assertion _limits.maxColorAttachments
+ * > 0"), and an aborting daemon is restarted by launchd, which is a loop. Published instead at
+ * registerService() time, the properties would exist before launchd, backboardd and SpringBoard
+ * are born, so each of the three would take the Metal road on its first call, with nobody left
+ * to read the log. Behind a boot-arg, a machine that has them is a machine booted on purpose to
+ * have them, and the first such boot is meant to be RC=rc.darwin, where launchd is never born.
+ *
+ * An empty string removes a property rather than setting it. That is the way out of the loop
+ * above without a reboot: the properties live only in the registry, so processes started after
+ * they are gone go back to the software road.
+ *
+ * Everything else is refused, and refused whole, before anything is set: every process on the
+ * machine can reach this method and the only thing it exists for is this one switch.
+ */
+IOReturn
+IOAcceleratorES::setProperties(OSObject * properties)
+{
+	OSDictionary * dict = OSDynamicCast(OSDictionary, properties);
+	OSCollectionIterator * keys;
+	OSObject * next;
+	char who[32] = "?";
+
+	if (!gAcceleratorTakesProperties) {
+		static unsigned said;
+
+		if (said++ < 4) {
+			proc_selfname(who, sizeof(who));
+			IOLog("IOAcceleratorES: %s asks to set properties on it; boot-arg metal=1 was not given\n", who);
+		}
+		return kIOReturnUnsupported;
+	}
+	if (dict == NULL || dict->getCount() == 0) {
+		return kIOReturnBadArgument;
+	}
+	keys = OSCollectionIterator::withCollection(dict);
+	if (keys == NULL) {
+		return kIOReturnNoMemory;
+	}
+	proc_selfname(who, sizeof(who));
+	while ((next = keys->getNextObject()) != NULL) {
+		const OSSymbol * key = OSDynamicCast(OSSymbol, next);
+
+		if (key == NULL || (!key->isEqualTo(kAcceleratorPluginNameKey) &&
+		    !key->isEqualTo(kAcceleratorPluginClassNameKey))) {
+			IOLog("IOAcceleratorES: refusing what %s sent: only " kAcceleratorPluginNameKey " and "
+			    kAcceleratorPluginClassNameKey " are taken here\n", who);
+			keys->release();
+			return kIOReturnUnsupported;
+		}
+		if (OSDynamicCast(OSString, dict->getObject(key)) == NULL) {
+			IOLog("IOAcceleratorES: refusing \"%s\" from %s: Metal reads it as a CFString\n",
+			    key->getCStringNoCopy(), who);
+			keys->release();
+			return kIOReturnBadArgument;
+		}
+	}
+	keys->reset();
+	while ((next = keys->getNextObject()) != NULL) {
+		const OSSymbol * key = OSDynamicCast(OSSymbol, next);
+		OSString * value = OSDynamicCast(OSString, dict->getObject(key));
+
+		if (value->getLength() == 0) {
+			removeProperty(key);
+			IOLog("IOAcceleratorES: %s removed by %s\n", key->getCStringNoCopy(), who);
+		} else if (setProperty(key, value)) {
+			IOLog("IOAcceleratorES: %s = %s, set by %s\n", key->getCStringNoCopy(),
+			    value->getCStringNoCopy(), who);
+		} else {
+			IOLog("IOAcceleratorES: %s could not be set\n", key->getCStringNoCopy());
+			keys->release();
+			return kIOReturnNoMemory;
+		}
+	}
+	keys->release();
+	return kIOReturnSuccess;
+}
+
+static void
+publishAccelerator(IOService * provider)
+{
+	IOAcceleratorES * accelerator = OSTypeAlloc(IOAcceleratorES);
+	uint32_t metal = 0;
+
+	gAcceleratorTakesProperties = PE_parse_boot_argn("metal", &metal, sizeof(metal)) && metal != 0;
+	if (accelerator != NULL && accelerator->init() && accelerator->attach(provider)) {
+		uint32_t metal = 0;
+
+		accelerator->setName("sgx");
+		/*
+		 * Boot-arg metal=1: say where Metal's device is (docs/metal-plan.md, step 1). Metal reads these two
+		 * properties, opens /System/Library/Extensions/<name>.bundle and takes the class (userland/src/HakiosMetal.m).
+		 * Never by default: with them a program that asks for Metal gets a device, and CoreAnimation would choose
+		 * Metal for the screen; until that device can draw, a screen drawn without it is the working one.
+		 */
+		if (PE_parse_boot_argn("metal", &metal, sizeof(metal)) && metal != 0) {
+			accelerator->setProperty("MetalPluginName", "HakiosMetal");
+			accelerator->setProperty("MetalPluginClassName", "HakiosMetalDevice");
+			IOLog("MiniIOMobileFramebuffer: metal=1: the accelerator names HakiosMetal as its Metal plug-in\n");
+		}
+		accelerator->registerService();
+		/* the first line to look for in the log of such a boot: the gate is open, nothing is set yet */
+		if (gAcceleratorTakesProperties) {
+			IOLog("IOAcceleratorES: metal=%u: this service takes " kAcceleratorPluginNameKey
+			    " and " kAcceleratorPluginClassNameKey " from user space\n", metal);
+		}
+	}
+	OSSafeReleaseNULL(accelerator);
+}
+
+/*
+ * A picture from inside the kernel (the GPU driver's first ones): rows of 32-bit pixels, put at
+ * the top left corner of the panel as they are and cut to its size.
+ */
+extern "C" void
+MiniIOMobileFramebufferShow(const uint8_t * pixels, uint32_t width, uint32_t height, uint32_t rowBytes)
+{
+	uint32_t columns = width < vinfo.v_width ? width : (uint32_t) vinfo.v_width;
+	uint32_t rows = height < vinfo.v_height ? height : (uint32_t) vinfo.v_height;
+
+	if (vinfo.v_baseaddr == 0 || vinfo.v_depth != 32) {
+		return;
+	}
+	for (uint32_t y = 0; y < rows; y++) {
+		memcpy((void *) (vinfo.v_baseaddr + (size_t) y * vinfo.v_rowbytes), pixels + (size_t) y * rowBytes,
+		    (size_t) columns * 4);
+	}
+}
+
+void
+MiniIOMobileFramebufferStart(IOService * provider)
+{
+	IOMobileFramebuffer * fb = OSTypeAlloc(IOMobileFramebuffer);
+
+	if (fb == NULL || !fb->init() || !fb->attach(provider)) {
+		OSSafeReleaseNULL(fb);
+		return;
+	}
+	if (fb->start(provider)) {
+		publishDisplayNode();
+		publishAccelerator(provider);
+	} else {
+		fb->detach(provider);
+	}
+	fb->release();
+}
diff --git a/iokit/Kernel/MiniIONetworkStack.cpp b/iokit/Kernel/MiniIONetworkStack.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..1fc93159509644f6ac26073d9313046b312ffbb1
--- /dev/null
+++ b/iokit/Kernel/MiniIONetworkStack.cpp
@@ -0,0 +1,114 @@
+/*
+ * MiniIONetworkStack: a stand-in for IONetworkStack of Apple's IONetworkingFamily, as seen by
+ * configd's interface namer.
+ *
+ * The real one gives the BSD names (en0, en1, ...) to the IONetworkInterface objects of the
+ * drivers, when the interface namer asks. Here interfaces are made with the BSD interface KPI
+ * (drivers/net/hakios.net.c) and are born with their names, so there is never anything to name.
+ * But the namer wants this object all the same: until it has opened it, it does not say in
+ * configd's store that the registry has gone quiet (the key Plugin:InterfaceNamer, "*QUIET*"),
+ * and gives up only after five minutes ("*TIMEOUT*"). SystemConfiguration's
+ * SCNetworkInterfaceCopyAll() waits for one of the two, and with it whoever asks for the list of
+ * interfaces: wifid as soon as it has a device, and behind wifid SpringBoard.
+ *
+ * So: the service, a user client that can be opened, and a refusal of the naming request.
+ */
+
+#include <IOKit/IOLib.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <sys/systm.h>
+#include <sys/proc.h>
+
+#include "MiniDrivers.h"
+
+class IONetworkStack : public IOService
+{
+	OSDeclareDefaultStructors(IONetworkStack);
+
+public:
+	virtual bool start(IOService * provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IONetworkStack, IOService);
+
+bool
+IONetworkStack::start(IOService * provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "IONetworkStackUserClient");
+	setName("IONetworkStack");
+	registerService();
+	return true;
+}
+
+class IONetworkStackUserClient : public IOUserClient
+{
+	OSDeclareDefaultStructors(IONetworkStackUserClient);
+
+public:
+	virtual bool start(IOService * provider) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn setProperties(OSObject * properties) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IONetworkStackUserClient, IOUserClient);
+
+bool
+IONetworkStackUserClient::start(IOService * provider)
+{
+	char who[32] = "?";
+
+	if (!IOUserClient::start(provider)) {
+		return false;
+	}
+	/* whether the registry is quiet at this moment is what the namer goes on to ask */
+	proc_selfname(who, sizeof(who));
+	IOLog("MiniIONetworkStack: opened by %s; the registry's busy state is %u\n", who,
+	    (unsigned) IOService::getServiceRoot()->getBusyState());
+	return true;
+}
+
+IOReturn
+IONetworkStackUserClient::clientClose(void)
+{
+	if (!isInactive()) {
+		terminate();
+	}
+	return kIOReturnSuccess;
+}
+
+/* "Name this interface" (a dictionary: IONetworkStackUserCommand, IOPathMatch, IOInterfaceUnit). */
+IOReturn
+IONetworkStackUserClient::setProperties(OSObject * properties)
+{
+	static unsigned said;
+
+	if (said++ < 4) {
+		IOLog("MiniIONetworkStack: asked to name an interface: there are none of that kind\n");
+	}
+	return kIOReturnUnsupported;
+}
+
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+void
+MiniIONetworkStackStart(void)
+{
+	/* where the real one is: IOService:/IOResources/IONetworkStack */
+	IOService * resources = IOService::getResourceService();
+	IONetworkStack * stack = OSTypeAlloc(IONetworkStack);
+
+	if (resources == NULL || stack == NULL || !stack->init() || !stack->attach(resources)) {
+		OSSafeReleaseNULL(stack);
+		IOLog("MiniIONetworkStack: cannot create the service\n");
+		return;
+	}
+	if (!stack->start(resources)) {
+		stack->detach(resources);
+	}
+	stack->release();
+}
diff --git a/iokit/Kernel/MiniIOSurface.cpp b/iokit/Kernel/MiniIOSurface.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..f1db4535db6fc8eafcd03ab2a5d3d298e86b28e3
--- /dev/null
+++ b/iokit/Kernel/MiniIOSurface.cpp
@@ -0,0 +1,2076 @@
+/*
+ * MiniIOSurface: a stand-in for Apple's closed IOSurface.kext (see MiniIOSurface.h).
+ *
+ * A surface is a piece of wired kernel memory: one page of state that clients read directly,
+ * followed by the pixels. Every client that knows a surface has the whole of it mapped once.
+ * Surfaces travel between processes as Mach send rights (IOSurfaceSendRight) or by number.
+ *
+ * What is not here: child surfaces, wrapping of client memory in pieces, purgeability, compression,
+ * notifications. Calls that are not implemented are logged once and refused.
+ */
+
+#include <IOKit/IOLib.h>
+#include <pexpert/pexpert.h>
+#include <IOKit/IOLocks.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <libkern/c++/OSSerialize.h>
+#include <libkern/c++/OSUnserialize.h>
+#include <libkern/c++/OSDictionary.h>
+#include <libkern/c++/OSCollectionIterator.h>
+#include <libkern/c++/OSSymbol.h>
+#include <libkern/c++/OSArray.h>
+#include <libkern/c++/OSNumber.h>
+#include <libkern/c++/OSBoolean.h>
+#include <libkern/c++/OSString.h>
+#include <libkern/c++/OSSymbol.h>
+#include <kern/thread_call.h>
+#include <sys/systm.h>
+#include <sys/proc.h>
+
+#include "MiniIOSurface.h"
+
+static_assert(sizeof(struct minisurf_plane) == 0x80, "plane layout");
+static_assert(sizeof(struct minisurf_result) == 0x68, "result layout");
+static_assert(offsetof(struct minisurf_shared, attachments) == 0x30, "shared layout");
+static_assert(sizeof(struct minisurf_result) + 20 * sizeof(struct minisurf_plane) == MINISURF_RESULT_MAX, "result size");
+
+/* IOConnectCallMethod selectors of IOSurfaceRootUserClient (Darwin userland 16.5) */
+enum {
+	kSurfaceMethodCreate            = 0,
+	kSurfaceMethodLookup            = 4,
+	kSurfaceMethodSetYCbCrMatrix    = 5,
+	kSurfaceMethodWrapClientImage   = 6,
+	kSurfaceMethodWrapClientMemory  = 7,
+	kSurfaceMethodSetValue          = 9,
+	kSurfaceMethodCopyValue         = 10,
+	kSurfaceMethodRemoveValue       = 11,
+	kSurfaceMethodBindAccel         = 12,
+	kSurfaceMethodInit              = 13,
+	kSurfaceMethodLog               = 19,
+	kSurfaceMethodSetPurgeable      = 20,
+	kSurfaceMethodSetOwnership      = 21,
+	kSurfaceMethodSetTiled          = 22,
+	kSurfaceMethodSetTimestamp      = 24,
+	kSurfaceMethodSetBulkAttachments = 27,
+	kSurfaceMethodCommPageAddress   = 32,
+	kSurfaceMethodSetIndexedTimestamp = 33,
+	kSurfaceMethodLookupFromPort    = 34,
+	kSurfaceMethodCreatePort        = 35,
+	kSurfaceMethodDetachModeCode    = 43,
+	kSurfaceMethodSetOwnershipIdentity = 44,
+};
+
+/* IOConnectTrap indices */
+enum {
+	kSurfaceTrapIncrementUseCount   = 0,
+	kSurfaceTrapDecrementUseCount   = 1,
+	kSurfaceTrapLock                = 2,
+	kSurfaceTrapUnlock              = 3,
+	kSurfaceTrapDetach              = 4,    /* the client is about to release: forget it has the surface */
+	kSurfaceTrapRelease             = 5,
+	kSurfaceTrapCount
+};
+
+#define kSurfaceLockReadOnly    1u
+
+#define MINISURF_TABLE_SIZE     16384
+#define MINISURF_MAX_DIMENSION  16384
+#define MINISURF_MAX_ALLOC      (512u << 20)
+#define MINISURF_ROW_ALIGN      64
+
+#define FOURCC(a, b, c, d) ((uint32_t)(a) << 24 | (uint32_t)(b) << 16 | (uint32_t)(c) << 8 | (uint32_t)(d))
+
+static IOLock *         gSurfaceLock;
+static MiniIOSurface *  gSurfaceTable[MINISURF_TABLE_SIZE];     /* index = surface number; [0] unused */
+static uint32_t         gSurfaceNext = 1;
+static uint32_t         gSurfaceCount;
+static uint64_t         gSurfaceBytes;
+static uint32_t         gSurfaceUnheld;         /* surfaces around client memory that could not be made (said a few times) */
+/* what making surfaces and taking them away has cost since it was last asked (MiniIOSurfaceCost()) */
+static uint64_t         gSurfaceMaking, gSurfaceFreeing;
+static uint32_t         gSurfacesMade, gSurfacesFreed;
+static uint64_t         gSurfaceLogged[2];                      /* selectors already complained about */
+/* Boot-arg surftrace=N: log the first N surfaces created (default 24). */
+static TUNABLE(uint32_t, gSurfaceTrace, "surftrace", 24);
+static uint32_t         gSurfaceTraced;                         /* (a tunable is read-only after boot) */
+/*
+ * Boot-arg surftrace_of=NAME: only the surfaces made by programs whose name begins with NAME count for
+ * surftrace (then up to N of theirs), and what becomes of them is said as well: the ports made for them
+ * and who looks them up from a port (another program, which shows it: the window server for a layer).
+ */
+static char             gSurfaceTraceOf[32];
+
+extern "C" void loader_log_line(const char *line);
+
+/* A line about a traced surface: to the loader's log too, where it outlives the kernel's own, short log. */
+static void
+traceLine(const char * format, ...)
+{
+	char line[256];
+	va_list list;
+
+	va_start(list, format);
+	vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	if (gSurfaceTraceOf[0] != 0) {
+		loader_log_line(line);
+	}
+	IOLog("%s", line);
+}
+
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+OSDefineMetaClassAndStructors(MiniIOSurface, OSObject);
+
+/*
+ * The memory of the big surfaces is kept when they go, a few pieces of it, and given to the
+ * next surface of the same size. CoreAnimation makes a surface of the whole display for every
+ * frame and frees one: 14 MB got, cleared, entered into the kernel's map and taken out of it
+ * again, sixty times a second -- 2.8 ms to make and 2 ms to free each, a quarter of the time
+ * there is for a frame, on the thread that draws it. A piece that is kept is cleared again
+ * before it is given out: a new surface is all zeroes, whoever makes it. The clearing is done
+ * by the display's driver between two frames (MiniIOSurfaceClearKept(): while it copies a
+ * frame to the panel the memory is busy enough, and the copy took half as long again when
+ * this ran beside it), or a moment later by a thread of this file's if no frames are going
+ * out, or by whoever asks for the memory if that comes first.
+ */
+#define SURFACE_KEEP_FROM       (4u << 20)      /* bytes: smaller ones are not worth it */
+#define SURFACE_KEPT            4
+#define SURFACE_CLEAR_MS        40              /* kept memory is cleared this long after, if the display's driver has not done it */
+
+static struct {
+	IOBufferMemoryDescriptor *      memory;
+	bool                            clear;          /* cleared since it was last a surface's */
+	bool                            busy;           /* being cleared right now */
+	uint64_t                        since;          /* when it was kept */
+} gSurfaceKept[SURFACE_KEPT];
+static uint32_t         gSurfacesNotKept[2];    /* memory not kept: somebody else had it too; it put out a piece kept longer */
+static IOLock *         gSurfaceKeptLock;
+static thread_call_t    gSurfaceClearing;
+static uint32_t         gSurfacesGivenAgain;    /* for MiniIOSurfaceCost() */
+/* boot-arg surf_clear=0: kept memory is given out as it is (to see what the clearing costs; a surface is then not all zeroes) */
+static TUNABLE(uint32_t, gSurfaceClear, "surf_clear", 1);
+/*
+ * fb_zc (MiniIOMobileFramebuffer.cpp): the window server's display surfaces made of the scan-out pool of the S9's DPU
+ * driver (drivers/display/dpu/hakios.exynos_dpu.c), for the display controller to scan them out with nothing copied. Which
+ * ones: of the size the display's driver says (MiniIOSurfaceScanout()), one plane of 'BGRA', made by backboardd; at most
+ * as many as the pool has slots (14), the others ordinary. Write-combined in every mapping, the kernel's, the window
+ * server's and the GPU's: the Mali and the DPU read memory, not the processors' caches.
+ */
+extern "C" {
+int hakios_scanout_carve(uint64_t bytes, uint64_t * phys);
+void hakios_scanout_uncarve(uint64_t phys);
+int hakios_mfc_carve(uint64_t bytes, uint64_t * phys);
+void hakios_mfc_uncarve(uint64_t phys);
+int hakios_surface_mfc_frame(uint32_t sid, uint64_t * y, uint64_t * uv, uint32_t * y_stride, uint32_t * uv_stride, uint32_t * y_bytes, uint32_t * uv_bytes);
+}
+static uint32_t gScanoutWidth, gScanoutHeight;
+static uint32_t gScanoutMade, gScanoutRefused;
+
+void
+MiniIOSurfaceScanout(uint32_t width, uint32_t height)
+{
+	gScanoutWidth = width;
+	gScanoutHeight = height;
+}
+
+static bool
+scanoutWanted(uint32_t width, uint32_t height, uint32_t format, uint32_t bpe, uint32_t ew, uint32_t eh, uint32_t planes,
+    uint32_t bpr, uint32_t offset)
+{
+	char name[32] = "";
+
+	if (gScanoutWidth == 0 || width != gScanoutWidth || height != gScanoutHeight || format != 'BGRA' || bpe != 4 ||
+	    ew != 1 || eh != 1 || planes != 0 || (bpr & 3) != 0 || bpr < width * 4 || (offset & 0xff) != 0) {
+		return false;
+	}
+	proc_selfname(name, sizeof(name));
+	return strcmp(name, "backboardd") == 0;
+}
+
+/* the video decoder's question: where a surface of its memory has its planes (hakios.exynos_mfc.c) */
+int
+hakios_surface_mfc_frame(uint32_t sid, uint64_t * y, uint64_t * uv, uint32_t * y_stride, uint32_t * uv_stride, uint32_t * y_bytes, uint32_t * uv_bytes)
+{
+	MiniIOSurface * s = MiniIOSurfaceCopy(sid);
+	int result = -1;
+
+	if (s != NULL && s->scanMFC && s->scanPhys != 0 && s->info.planeCount == 2) {
+		*y = s->scanPhys + s->planes[0].offset;
+		*uv = s->scanPhys + s->planes[1].offset;
+		*y_stride = s->planes[0].bytesPerRow;
+		*uv_stride = s->planes[1].bytesPerRow;
+		*y_bytes = s->planes[0].size;
+		*uv_bytes = s->planes[1].size;
+		result = 0;
+	}
+	if (s != NULL) {
+		MiniIOSurfaceDrop(s);
+	}
+	return result;
+}
+
+void
+MiniIOSurfaceUse(MiniIOSurface * s, int delta)
+{
+	if (s == NULL || gSurfaceLock == NULL) {
+		return;
+	}
+	IOLockLock(gSurfaceLock);
+	s->useCount[0] += delta;
+	s->shared()->useCount = (uint64_t) s->useCount[1] << 32 | s->useCount[0];
+	IOLockUnlock(gSurfaceLock);
+}
+
+/* boot-arg surf_wrap=0: surfaces around the client's pictures refused, as before methodWrapClientImage (for comparing) */
+static TUNABLE(uint32_t, gSurfaceWrap, "surf_wrap", 1);
+
+void
+MiniIOSurfaceClearKept(void)
+{
+	if (gSurfaceKeptLock == NULL || !gSurfaceClear) {
+		return;
+	}
+	IOLockLock(gSurfaceKeptLock);
+	for (unsigned i = 0; i < SURFACE_KEPT; i++) {
+		IOBufferMemoryDescriptor * memory = gSurfaceKept[i].memory;
+
+		if (memory == NULL || gSurfaceKept[i].clear || gSurfaceKept[i].busy) {
+			continue;
+		}
+		gSurfaceKept[i].busy = true;
+		IOLockUnlock(gSurfaceKeptLock);
+		bzero(memory->getBytesNoCopy(), memory->getCapacity());
+		IOLockLock(gSurfaceKeptLock);
+		gSurfaceKept[i].busy = false;
+		gSurfaceKept[i].clear = true;
+	}
+	IOLockUnlock(gSurfaceKeptLock);
+}
+
+static void
+surfaceMemoryClear(thread_call_param_t unused0 __unused, thread_call_param_t unused1 __unused)
+{
+	MiniIOSurfaceClearKept();
+}
+
+/* Memory for a surface: the state page and `bytes` after it, all zeroes. */
+static IOBufferMemoryDescriptor *
+surfaceMemory(vm_size_t bytes)
+{
+	IOBufferMemoryDescriptor * memory = NULL;
+	bool clear = false;
+
+	if (bytes >= SURFACE_KEEP_FROM && gSurfaceKeptLock != NULL) {
+		IOLockLock(gSurfaceKeptLock);
+		for (int pass = 0; pass < 2 && memory == NULL; pass++) {
+			/* one that is clear already, if there is one */
+			for (unsigned i = 0; i < SURFACE_KEPT && memory == NULL; i++) {
+				if (gSurfaceKept[i].memory != NULL && !gSurfaceKept[i].busy && (pass == 1 || gSurfaceKept[i].clear) &&
+				    gSurfaceKept[i].memory->getCapacity() == bytes) {
+					memory = gSurfaceKept[i].memory;
+					clear = gSurfaceKept[i].clear;
+					gSurfaceKept[i].memory = NULL;
+				}
+			}
+		}
+		gSurfacesGivenAgain += memory != NULL;
+		IOLockUnlock(gSurfaceKeptLock);
+		if (memory != NULL && !clear) {
+			bzero(memory->getBytesNoCopy(), gSurfaceClear ? bytes : PAGE_SIZE);
+		}
+	}
+	if (memory == NULL) {
+		memory = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task, kIODirectionInOut | kIOMemoryKernelUserShared, bytes,
+		    PAGE_SIZE);
+	}
+	return memory;
+}
+
+/*
+ * A surface is gone: its memory is kept for the next, if it is big and nobody else has it. When
+ * all the places are taken, it takes the place of the piece kept longest: pieces of a size nobody
+ * asks for again (a big picture made once) once stayed there for good, and then no frame's memory
+ * was kept any more -- each made afresh and freed (2 to 4 ms, and 1 to 2) instead of 0.3 and 0.05.
+ */
+static void
+surfaceMemoryBack(IOBufferMemoryDescriptor * memory)
+{
+	IOBufferMemoryDescriptor * evicted = NULL;
+
+	if (memory->getCapacity() >= SURFACE_KEEP_FROM && memory->getRetainCount() != 1) {
+		OSIncrementAtomic(&gSurfacesNotKept[0]);
+	}
+	if (memory->getCapacity() >= SURFACE_KEEP_FROM && memory->getRetainCount() == 1 && gSurfaceKeptLock != NULL) {
+		int oldest = -1;
+
+		IOLockLock(gSurfaceKeptLock);
+		for (unsigned i = 0; i < SURFACE_KEPT && memory != NULL; i++) {
+			if (gSurfaceKept[i].memory == NULL) {
+				gSurfaceKept[i].memory = memory;
+				gSurfaceKept[i].clear = gSurfaceKept[i].busy = false;
+				gSurfaceKept[i].since = mach_absolute_time();
+				memory = NULL;
+			} else if (!gSurfaceKept[i].busy && (oldest < 0 || gSurfaceKept[i].since < gSurfaceKept[oldest].since)) {
+				oldest = (int) i;
+			}
+		}
+		if (memory != NULL && oldest >= 0) {
+			evicted = gSurfaceKept[oldest].memory;
+			gSurfaceKept[oldest].memory = memory;
+			gSurfaceKept[oldest].clear = gSurfaceKept[oldest].busy = false;
+			gSurfaceKept[oldest].since = mach_absolute_time();
+			memory = NULL;
+			gSurfacesNotKept[1]++;
+		}
+		IOLockUnlock(gSurfaceKeptLock);
+		if (evicted != NULL) {
+			evicted->release();
+		}
+		if (memory == NULL) {
+			if (gSurfaceClear) {
+				AbsoluteTime deadline;
+
+				clock_interval_to_deadline(SURFACE_CLEAR_MS, kMillisecondScale, &deadline);
+				thread_call_enter_delayed(gSurfaceClearing, deadline);
+			}
+			return;
+		}
+	}
+	memory->release();
+}
+
+void
+MiniIOSurface::free(void)
+{
+	uint64_t began = mach_absolute_time();
+
+	if (traced && kpixels != NULL) {
+		uint32_t nonzero = 0, middle = 0;
+
+		for (uint32_t at = 0; at + 4 <= info.allocSize; at += 64) {
+			nonzero += kpixels[at] != 0 || kpixels[at + 1] != 0 || kpixels[at + 2] != 0 || kpixels[at + 3] != 0;
+		}
+		memcpy(&middle, kpixels + (info.allocSize / 2 & ~3u), 4);
+		traceLine("MiniIOSurface: surface %u (%ux%u) goes: of every 64 bytes %u of %u begin with a pixel that is not 0, one in "
+		    "the middle %#010x\n", sid, info.width, info.height, nonzero, info.allocSize / 64, middle);
+	}
+
+	OSSafeReleaseNULL(values);
+	OSSafeReleaseNULL(clientMap);
+	if (scanPhys != 0) {
+		/* (the display holds a surface it shows: nobody scans this memory out any more) */
+		OSSafeReleaseNULL(scanMap);
+		OSSafeReleaseNULL(scan);
+		if (scanMFC) {
+			hakios_mfc_uncarve(scanPhys);
+		} else {
+			hakios_scanout_uncarve(scanPhys);
+		}
+		scanPhys = 0;
+	}
+	if (client != NULL) {
+		client->complete();
+		client->release();
+		client = NULL;
+	}
+	if (memory != NULL) {
+		surfaceMemoryBack(memory);
+		memory = NULL;
+	}
+	OSObject::free();
+	OSAddAtomic64((SInt64) (mach_absolute_time() - began), (SInt64 *) &gSurfaceFreeing);
+	OSIncrementAtomic(&gSurfacesFreed);
+}
+
+/* How many surfaces were made and freed since this was last asked, and the microseconds each took on average. */
+void
+MiniIOSurfaceCost(uint32_t * made, uint64_t * making, uint32_t * freed, uint64_t * freeing, uint32_t * again)
+{
+	uint64_t nanos;
+
+	*again = OSBitAndAtomic(0, &gSurfacesGivenAgain);
+
+	*made = OSBitAndAtomic(0, &gSurfacesMade);
+	*freed = OSBitAndAtomic(0, &gSurfacesFreed);
+	absolutetime_to_nanoseconds(gSurfaceMaking, &nanos);
+	*making = *made ? nanos / NSEC_PER_USEC / *made : 0;
+	absolutetime_to_nanoseconds(gSurfaceFreeing, &nanos);
+	*freeing = *freed ? nanos / NSEC_PER_USEC / *freed : 0;
+	gSurfaceMaking = gSurfaceFreeing = 0;
+}
+
+/* The values changed: a new seed, and how much room a client needs to fetch them. */
+void
+MiniIOSurface::updateValuesState(void)
+{
+	struct minisurf_shared * sh = shared();
+	uint32_t size = 0;
+
+	if (values != NULL && values->getCount() != 0) {
+		OSSerialize * s = OSSerialize::binaryWithCapacity(4096);
+		if (s != NULL) {
+			if (values->serialize(s)) {
+				size = s->getLength() + 8;
+			}
+			s->release();
+		}
+	}
+	sh->valuesSeed = (sh->valuesSeed + 2) | 1;
+	sh->valuesSize = size;
+}
+
+static uint32_t
+dictNumber(OSDictionary * dict, const char * key, uint32_t missing)
+{
+	OSObject * obj = dict ? dict->getObject(key) : NULL;
+	OSNumber * num = OSDynamicCast(OSNumber, obj);
+
+	if (num != NULL) {
+		return num->unsigned32BitValue();
+	}
+	if (obj == kOSBooleanTrue) {
+		return 1;
+	}
+	if (obj == kOSBooleanFalse) {
+		return 0;
+	}
+	return missing;
+}
+
+static uint32_t
+alignUp(uint64_t value, uint32_t to)
+{
+	return (uint32_t) ((value + to - 1) / to * to);
+}
+
+/* Bytes per element when the client did not say. */
+static uint32_t
+defaultBytesPerElement(uint32_t format)
+{
+	switch (format) {
+	case FOURCC('L', '0', '0', '8'):
+	case FOURCC('A', '0', '0', '8'):
+	case 0x00000008:
+		return 1;
+	case FOURCC('L', '5', '6', '5'):
+	case FOURCC('B', '5', '6', '5'):
+	case FOURCC('L', '5', '5', '5'):
+	case FOURCC('2', 'v', 'u', 'y'):
+	case FOURCC('y', 'u', 'v', 's'):
+	case FOURCC('y', 'u', 'v', 'f'):
+	case FOURCC('L', '0', '1', '6'):
+	case FOURCC('L', '0', '0', 'h'):
+		return 2;
+	case FOURCC('R', 'G', 'h', 'A'):
+		return 8;
+	case FOURCC('R', 'G', 'f', 'A'):
+		return 16;
+	default:
+		return 4;
+	}
+}
+
+/*
+ * Two-plane YCbCr formats: luma, then interleaved chroma.
+ * Returns false for anything else. *wide: 10-bit samples in 16 bits.
+ */
+static bool
+biplanarLayout(uint32_t format, uint32_t * hsub, uint32_t * vsub, bool * wide)
+{
+	switch (format) {
+	case FOURCC('4', '2', '0', 'v'): case FOURCC('4', '2', '0', 'f'):
+		*hsub = 2; *vsub = 2; *wide = false; return true;
+	case FOURCC('4', '2', '2', 'v'): case FOURCC('4', '2', '2', 'f'):
+		*hsub = 2; *vsub = 1; *wide = false; return true;
+	case FOURCC('4', '4', '4', 'v'): case FOURCC('4', '4', '4', 'f'):
+		*hsub = 1; *vsub = 1; *wide = false; return true;
+	case FOURCC('x', '4', '2', '0'): case FOURCC('x', 'f', '2', '0'):
+		*hsub = 2; *vsub = 2; *wide = true; return true;
+	case FOURCC('x', '4', '2', '2'): case FOURCC('x', 'f', '2', '2'):
+		*hsub = 2; *vsub = 1; *wide = true; return true;
+	case FOURCC('x', '4', '4', '4'): case FOURCC('x', 'f', '4', '4'):
+		*hsub = 1; *vsub = 1; *wide = true; return true;
+	default:
+		return false;
+	}
+}
+
+static void
+describeComponents(struct minisurf_plane * plane, uint32_t format)
+{
+	/* in memory order; names: 1 alpha, 2 red, 3 green, 4 blue */
+	static const uint8_t bgra[4] = { 4, 3, 2, 1 };
+	static const uint8_t rgba[4] = { 2, 3, 4, 1 };
+	const uint8_t * names;
+
+	if (format == FOURCC('B', 'G', 'R', 'A')) {
+		names = bgra;
+	} else if (format == FOURCC('R', 'G', 'B', 'A')) {
+		names = rgba;
+	} else {
+		return;
+	}
+	plane->componentCount = 4;
+	for (unsigned i = 0; i < 4; i++) {
+		plane->componentBitDepth[i] = 8;
+		plane->componentBitOffset[i] = (uint8_t) (8 * i);
+		plane->componentName[i] = names[i];
+		plane->componentType[i] = 1;            /* unsigned integer */
+		plane->componentRange[i] = 1;           /* full range */
+	}
+}
+
+/*
+ * Make a surface from the properties a client gave to IOSurfaceCreate().
+ * Returned with one holder, and entered in the table.
+ */
+static MiniIOSurface *
+surfaceCreate(OSDictionary * props, IOReturn * error)
+{
+	MiniIOSurface * s;
+	struct minisurf_result * info;
+	uint32_t width, height, format, bpe, ew, eh, bpr, alloc, offset, planeCount = 0;
+	uint32_t hsub, vsub;
+	bool wide, onePlane = false;
+	OSArray * planeInfo;
+	OSNumber * wrapped;
+	uint64_t needed;
+
+	*error = kIOReturnBadArgument;
+	width = dictNumber(props, "IOSurfaceWidth", 0);
+	height = dictNumber(props, "IOSurfaceHeight", 0);
+	format = dictNumber(props, "IOSurfacePixelFormat", 0);
+	/*
+	 * Ten bits a colour, packed into 32-bit pixels: what a device with a wide-gamut display
+	 * (the iPhone X is one) asks for when it wants a picture of the screen, a snapshot for a
+	 * transition for instance. CoreAnimation's software renderer does not draw into those
+	 * ("SW renderer invalid destination format w30r": the transition comes out black), and
+	 * there is no wide gamut on this panel anyway. The surface is made as ordinary BGRA of
+	 * the same geometry, and says so: whoever uses it reads the format back from the surface.
+	 */
+	if (format == 'w30r' || format == 'l10r' || format == 'w30R') {
+		format = 'BGRA';
+	}
+	/*
+	 * The same with alpha in a plane of its own: what CoreAnimation makes the screen's own
+	 * surfaces of once it draws with a GPU's renderer (OpenGL ES, userland/src/eagl.c) instead
+	 * of its software one. One plane of BGRA here too; the framebuffer shows nothing else.
+	 */
+	if (format == 'b3a8') {
+		format = 'BGRA';
+		onePlane = true;
+	}
+	ew = dictNumber(props, "IOSurfaceElementWidth", 1);
+	eh = dictNumber(props, "IOSurfaceElementHeight", 1);
+	bpe = dictNumber(props, "IOSurfaceBytesPerElement", 0);
+	offset = dictNumber(props, "IOSurfaceOffset", 0);
+	if (width > MINISURF_MAX_DIMENSION || height > MINISURF_MAX_DIMENSION || ew == 0 || eh == 0 || ew > 255 || eh > 255) {
+		return NULL;
+	}
+	if (props->getObject("IOSurfaceAddressRanges") != NULL) {
+		IOLog("MiniIOSurface: wrapping client memory in pieces is not supported\n");
+		*error = kIOReturnUnsupported;
+		return NULL;
+	}
+	/*
+	 * A surface around memory the client has already: CoreAnimation's OpenGL ES renderer makes
+	 * them around pictures it has in memory (an application's icon, a layer's contents as the
+	 * application has drawn them), to hand them to the GPU as they are. The surface's pixels
+	 * are that memory itself, not a copy: the picture goes on being drawn into after the
+	 * surface is made, and whoever looks at the surface is to see what is there now.
+	 */
+	wrapped = OSDynamicCast(OSNumber, props->getObject("IOSurfaceAddress"));
+
+	s = OSTypeAlloc(MiniIOSurface);
+	if (s == NULL || !s->init()) {
+		OSSafeReleaseNULL(s);
+		*error = kIOReturnNoMemory;
+		return NULL;
+	}
+	info = &s->info;
+
+	planeInfo = onePlane ? NULL : OSDynamicCast(OSArray, props->getObject("IOSurfacePlaneInfo"));
+	needed = 0;
+	if (planeInfo != NULL && planeInfo->getCount() != 0) {
+		planeCount = planeInfo->getCount();
+		if (planeCount > MINISURF_MAX_PLANES) {
+			IOLog("MiniIOSurface: %u planes asked for, %u supported\n", planeCount, MINISURF_MAX_PLANES);
+			s->release();
+			return NULL;
+		}
+		for (uint32_t i = 0; i < planeCount; i++) {
+			OSDictionary * pd = OSDynamicCast(OSDictionary, planeInfo->getObject(i));
+			struct minisurf_plane * p = &s->planes[i];
+			uint32_t pew = dictNumber(pd, "IOSurfacePlaneElementWidth", 1);
+			uint32_t peh = dictNumber(pd, "IOSurfacePlaneElementHeight", 1);
+
+			if (pew == 0 || peh == 0 || pew > 255 || peh > 255) {
+				s->release();
+				return NULL;
+			}
+			p->width = dictNumber(pd, "IOSurfacePlaneWidth", width);
+			p->height = dictNumber(pd, "IOSurfacePlaneHeight", height);
+			/* a plane is no bigger than a surface may be: the sizes below are not allowed to wrap */
+			if (p->width > MINISURF_MAX_DIMENSION || p->height > MINISURF_MAX_DIMENSION) {
+				s->release();
+				return NULL;
+			}
+			p->bytesPerElement = (uint16_t) dictNumber(pd, "IOSurfacePlaneBytesPerElement", bpe ? bpe : 1);
+			p->elementWidth = (uint8_t) pew;
+			p->elementHeight = (uint8_t) peh;
+			p->bytesPerRow = dictNumber(pd, "IOSurfacePlaneBytesPerRow", 0);
+			if (p->bytesPerRow == 0) {
+				p->bytesPerRow = alignUp((uint64_t) ((p->width + pew - 1) / pew) * p->bytesPerElement, MINISURF_ROW_ALIGN);
+			}
+			p->size = dictNumber(pd, "IOSurfacePlaneSize", 0);
+			if (p->size == 0) {
+				/* (in 64 bits: a stride of the caller's times the rows can pass 32) */
+				uint64_t planeBytes = (uint64_t) p->bytesPerRow * ((p->height + peh - 1) / peh);
+
+				if (planeBytes > MINISURF_MAX_ALLOC) {
+					s->release();
+					return NULL;
+				}
+				p->size = (uint32_t) planeBytes;
+			}
+			p->offset = dictNumber(pd, "IOSurfacePlaneOffset", dictNumber(pd, "IOSurfacePlaneBase", (uint32_t) needed));
+			p->extendedPixels[0] = dictNumber(pd, "IOSurfacePlaneExtendedPixelsOnLeft", 0);
+			p->extendedPixels[1] = dictNumber(pd, "IOSurfacePlaneExtendedPixelsOnRight", 0);
+			p->extendedPixels[2] = dictNumber(pd, "IOSurfacePlaneExtendedPixelsOnTop", 0);
+			p->extendedPixels[3] = dictNumber(pd, "IOSurfacePlaneExtendedPixelsOnBottom", 0);
+			if ((uint64_t) p->offset + p->size > needed) {
+				needed = (uint64_t) p->offset + p->size;
+			}
+		}
+	} else if (biplanarLayout(format, &hsub, &vsub, &wide) && width != 0 && height != 0) {
+		struct minisurf_plane * y = &s->planes[0], * c = &s->planes[1];
+
+		planeCount = 2;
+		y->width = width;
+		y->height = height;
+		y->bytesPerElement = wide ? 2 : 1;
+		y->elementWidth = y->elementHeight = 1;
+		y->bytesPerRow = alignUp((uint64_t) width * y->bytesPerElement, MINISURF_ROW_ALIGN);
+		y->size = y->bytesPerRow * height;
+		y->offset = 0;
+		c->width = (width + hsub - 1) / hsub;
+		c->height = (height + vsub - 1) / vsub;
+		c->bytesPerElement = wide ? 4 : 2;
+		c->elementWidth = c->elementHeight = 1;
+		c->bytesPerRow = alignUp((uint64_t) c->width * c->bytesPerElement, MINISURF_ROW_ALIGN);
+		c->size = c->bytesPerRow * c->height;
+		c->offset = y->size;
+		needed = (uint64_t) c->offset + c->size;
+	}
+
+	if (bpe == 0) {
+		bpe = planeCount ? s->planes[0].bytesPerElement : defaultBytesPerElement(format);
+	}
+	bpr = dictNumber(props, "IOSurfaceBytesPerRow", 0);
+	if (bpr == 0) {
+		bpr = planeCount ? s->planes[0].bytesPerRow
+		    : alignUp((uint64_t) ((width + ew - 1) / ew) * bpe, MINISURF_ROW_ALIGN);
+	}
+	if (planeCount == 0) {
+		needed = (uint64_t) bpr * ((height + eh - 1) / eh);
+		/* the one implicit plane, for the per-plane getters */
+		s->planes[0].width = width;
+		s->planes[0].height = height;
+		s->planes[0].bytesPerRow = bpr;
+		s->planes[0].bytesPerElement = (uint16_t) bpe;
+		s->planes[0].elementWidth = (uint8_t) ew;
+		s->planes[0].elementHeight = (uint8_t) eh;
+		s->planes[0].size = (uint32_t) needed;
+		describeComponents(&s->planes[0], format);
+	}
+	needed += offset;
+	alloc = dictNumber(props, "IOSurfaceAllocSize", 0);
+	if (alloc < needed) {
+		/* (a surface around the owner's memory has the owner's size: a mask's last row is only as long as it is wide) */
+		if (alloc != 0 && wrapped == NULL) {
+			IOLog("MiniIOSurface: alloc size %u too small for %ux%u '%.4s', using %llu\n", alloc, width, height,
+			    (const char *) &format, needed);
+		}
+		if (needed > MINISURF_MAX_ALLOC) {
+			s->release();
+			return NULL;
+		}
+		alloc = (uint32_t) needed;
+	}
+	if (alloc == 0 || alloc > MINISURF_MAX_ALLOC) {
+		s->release();
+		return NULL;
+	}
+	if (wrapped == NULL) {
+		alloc = alignUp(alloc, (uint32_t) PAGE_SIZE);
+	} else {
+		/* (the memory is as big as its owner says, and not a byte of ours is added to it) */
+		alloc = dictNumber(props, "IOSurfaceAllocSize", (uint32_t) needed);
+		/* the owner's number replaced the checked one above: it gets the same limits, so that a size of 0 or of gigabytes is not taken */
+		if (alloc == 0 || alloc > MINISURF_MAX_ALLOC) {
+			s->release();
+			return NULL;
+		}
+	}
+
+	if (wrapped == NULL && scanoutWanted(width, height, format, bpe, ew, eh, planeCount, bpr, offset)) {
+		uint64_t phys = 0;
+
+		if (hakios_scanout_carve(alloc, &phys) == 0) {
+			s->scan = IOMemoryDescriptor::withPhysicalAddress((IOPhysicalAddress) phys, alloc, kIODirectionInOut);
+			s->scanMap = s->scan != NULL ? s->scan->createMappingInTask(kernel_task, 0, kIOMapAnywhere |
+			    kIOMapWriteCombineCache) : NULL;
+			if (s->scanMap == NULL) {
+				OSSafeReleaseNULL(s->scan);
+				hakios_scanout_uncarve(phys);
+			} else {
+				s->scanPhys = phys;
+				bzero((void *) s->scanMap->getVirtualAddress(), alloc);
+			}
+		}
+		if (s->scanPhys == 0 && gScanoutRefused++ < 4) {
+			IOLog("MiniIOSurface: fb_zc: a display surface (%ux%u, %u bytes a row) not made of the scan-out pool: %s\n",
+			    width, height, bpr, s->scan == NULL ? "no slot free" : "not mapped");
+		}
+	}
+	if (wrapped == NULL && s->scanPhys == 0 && planeCount == 2 && dictNumber(props, "HakiosMFCFrame", 0) != 0) {
+		/* mfc_zc (hakios.exynos_mfc.c): a frame of video the block decodes into, as fb_zc's above; only mediaserverd's, where the decoder is */
+		char name[32] = "";
+		uint64_t phys = 0;
+
+		proc_selfname(name, sizeof(name));
+		if (strcmp(name, "mediaserverd") == 0 && hakios_mfc_carve(alloc, &phys) == 0) {
+			s->scan = IOMemoryDescriptor::withPhysicalAddress((IOPhysicalAddress) phys, alloc, kIODirectionInOut);
+			s->scanMap = s->scan != NULL ? s->scan->createMappingInTask(kernel_task, 0, kIOMapAnywhere | kIOMapWriteCombineCache) : NULL;
+			if (s->scanMap == NULL) {
+				OSSafeReleaseNULL(s->scan);
+				hakios_mfc_uncarve(phys);
+			} else {
+				s->scanPhys = phys;
+				s->scanMFC = true;
+				bzero((void *) s->scanMap->getVirtualAddress(), alloc);
+			}
+		}
+	}
+	s->memory = surfaceMemory((vm_size_t) PAGE_SIZE + (wrapped || s->scanPhys ? 0 : alloc));
+	if (s->memory == NULL) {
+		IOLog("MiniIOSurface: no memory for %u bytes (%u surfaces, %llu MB in use)\n", alloc, gSurfaceCount,
+		    gSurfaceBytes >> 20);
+		s->release();
+		*error = kIOReturnNoMemory;
+		return NULL;
+	}
+	s->kbase = (uint8_t *) s->memory->getBytesNoCopy();
+	s->values = OSDictionary::withCapacity(4);
+	s->kpixels = s->scanPhys != 0 ? (uint8_t *) s->scanMap->getVirtualAddress() : s->kbase + PAGE_SIZE;
+	if (s->scanPhys != 0 && !s->scanMFC && gScanoutMade++ < 16) {
+		IOLog("MiniIOSurface: fb_zc: a display surface (%ux%u, %u bytes a row, %u bytes) made of the scan-out pool at "
+		    "%#llx\n", width, height, bpr, alloc, s->scanPhys);
+	}
+	if (wrapped != NULL) {
+		s->clientTask = current_task();
+		s->clientAddress = wrapped->unsigned64BitValue();
+		IOReturn held = kIOReturnNoMemory;
+
+		/* (held for writing if it can be written, which a picture that is only shown need not be) */
+		for (unsigned attempt = 0; attempt < 2 && held != kIOReturnSuccess; attempt++) {
+			OSSafeReleaseNULL(s->client);
+			s->client = IOMemoryDescriptor::withAddressRange(s->clientAddress, alloc,
+			    attempt == 0 ? kIODirectionInOut : kIODirectionOut, s->clientTask);
+			held = s->client != NULL ? s->client->prepare() : kIOReturnNoMemory;
+		}
+		if (held == kIOReturnSuccess) {
+			s->clientMap = s->client->createMappingInTask(kernel_task, 0, kIOMapAnywhere | kIOMapReadOnly);
+		} else {
+			OSSafeReleaseNULL(s->client);
+		}
+		if (s->clientMap == NULL) {
+			if (gSurfaceUnheld++ < 8) {
+				IOLog("MiniIOSurface: the memory to make a surface around (%u bytes at %#llx) cannot be %s (%#x)\n", alloc,
+				    s->clientAddress, held == kIOReturnSuccess ? "seen from here" : "held", held);
+			}
+			s->release();
+			*error = kIOReturnVMError;
+			return NULL;
+		}
+		s->kpixels = (uint8_t *) s->clientMap->getVirtualAddress();
+	}
+
+	info->allocSize = alloc;
+	info->width = width;
+	info->height = height;
+	info->bytesPerRow = bpr;
+	info->offset = offset;
+	info->pixelFormat = format;
+	info->planeCount = planeCount;
+	info->bytesPerElement = (uint16_t) bpe;
+	info->elementWidth = (uint8_t) ew;
+	info->elementHeight = (uint8_t) eh;
+	info->cacheMode = dictNumber(props, "IOSurfaceCacheMode", 0);
+	info->subsampling = (uint8_t) dictNumber(props, "IOSurfaceSubsampling", 0);
+	info->prohibitUseCount = (uint8_t) dictNumber(props, "IOSurfaceProhibitUseCount", 0);
+	info->sliceCount = dictNumber(props, "IOSurfaceSliceCount", 0);
+	info->protectionOptions = dictNumber(props, "IOSurfaceProtectionOptions", 0);
+
+	IOLockLock(gSurfaceLock);
+	uint32_t sid = 0;
+	for (uint32_t tries = 0; tries < MINISURF_TABLE_SIZE - 1; tries++) {
+		uint32_t candidate = gSurfaceNext;
+
+		gSurfaceNext = (gSurfaceNext + 1 < MINISURF_TABLE_SIZE) ? gSurfaceNext + 1 : 1;
+		if (gSurfaceTable[candidate] == NULL) {
+			sid = candidate;
+			break;
+		}
+	}
+	if (sid == 0) {
+		IOLockUnlock(gSurfaceLock);
+		IOLog("MiniIOSurface: the surface table is full\n");
+		s->release();
+		*error = kIOReturnNoResources;
+		return NULL;
+	}
+	s->sid = sid;
+	s->holders = 1;
+	info->sid = sid;
+	info->traceID = sid;
+	gSurfaceTable[sid] = s;                 /* the table owns the object until the last holder goes */
+	gSurfaceCount++;
+	gSurfaceBytes += alloc;
+
+	struct minisurf_shared * sh = s->shared();
+	sh->registryID = 0x100000000ULL + sid;
+	sh->seed = 1;
+	sh->valuesSeed = 1;
+	sh->pixelSizeCasting = (uint8_t) dictNumber(props, "IOSurfacePixelSizeCastingAllowed", 1);
+	sh->displayable = 1;
+	sh->sysMemOnly = (uint8_t) dictNumber(props, "IOSurfaceSysMemOnly", 0);
+	IOLockUnlock(gSurfaceLock);
+
+	*error = kIOReturnSuccess;
+	return s;
+}
+
+/* With the lock held. */
+static void
+surfaceHold(MiniIOSurface * s)
+{
+	s->holders++;
+}
+
+/* With the lock held. The caller must not touch the surface afterwards. */
+static void
+surfaceUnhold(MiniIOSurface * s)
+{
+	if (--s->holders != 0) {
+		return;
+	}
+	gSurfaceTable[s->sid] = NULL;
+	gSurfaceCount--;
+	gSurfaceBytes -= s->info.allocSize;
+	s->release();
+}
+
+MiniIOSurface *
+MiniIOSurfaceCopy(uint32_t sid)
+{
+	MiniIOSurface * s = NULL;
+
+	if (gSurfaceLock == NULL || sid == 0 || sid >= MINISURF_TABLE_SIZE) {
+		return NULL;
+	}
+	IOLockLock(gSurfaceLock);
+	s = gSurfaceTable[sid];
+	if (s != NULL) {
+		surfaceHold(s);
+	}
+	IOLockUnlock(gSurfaceLock);
+	return s;
+}
+
+/* How many surfaces there are and how much (wired) memory they hold: for the kernel's memory report. */
+extern "C" void
+MiniIOSurfaceUsage(uint32_t * count, uint64_t * bytes)
+{
+	*count = gSurfaceCount;
+	*bytes = gSurfaceBytes;
+}
+
+void
+MiniIOSurfaceDrop(MiniIOSurface * s)
+{
+	if (s == NULL) {
+		return;
+	}
+	IOLockLock(gSurfaceLock);
+	surfaceUnhold(s);
+	IOLockUnlock(gSurfaceLock);
+}
+
+MiniIOSurface *
+MiniIOSurfaceCreateSimple(uint32_t width, uint32_t height, uint32_t pixelFormat)
+{
+	OSDictionary * props = OSDictionary::withCapacity(4);
+	MiniIOSurface * s = NULL;
+	IOReturn error;
+
+	if (props == NULL || gSurfaceLock == NULL) {
+		OSSafeReleaseNULL(props);
+		return NULL;
+	}
+	OSNumber * n;
+	n = OSNumber::withNumber(width, 32); props->setObject("IOSurfaceWidth", n); n->release();
+	n = OSNumber::withNumber(height, 32); props->setObject("IOSurfaceHeight", n); n->release();
+	n = OSNumber::withNumber(pixelFormat, 32); props->setObject("IOSurfacePixelFormat", n); n->release();
+	s = surfaceCreate(props, &error);
+	props->release();
+	return s;
+}
