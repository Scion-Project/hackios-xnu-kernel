+extern "C" uint64_t loader_recording[3];        /* { physical address, bytes, kernel address }: osfmk/arm64/loader_return.c */
+
+static uint32_t
+swapWord(const uint8_t * swap, unsigned offset)
+{
+	uint32_t value;
+
+	memcpy(&value, swap + offset, sizeof(value));
+	return value;
+}
