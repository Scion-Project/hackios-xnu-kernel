diff --git a/bsd/conf/Makefile b/bsd/conf/Makefile
index 050f34a53c49673de3af7d3633bb534e6c0e77c7..c58ff62cd41966a348e8489a9543c0de689b7b93 100644
--- a/bsd/conf/Makefile
+++ b/bsd/conf/Makefile
@@ -17,6 +17,9 @@ MASTERCONFDIR = $(SRCROOT)/config
 DOCONFDEPS = $(addprefix $(MASTERCONFDIR)/, MASTER MASTER.$(DOCONF_ARCH_CONFIG_LC)) \
 	$(addprefix $(SOURCE)/, Makefile.template Makefile.$(DOCONF_ARCH_CONFIG_LC) files files.$(DOCONF_ARCH_CONFIG_LC))
 
+# HakiOS: the drivers' choice (tools/hakios-config.py kernel); a new choice makes the configuration again
+DOCONFDEPS += $(wildcard $(MASTERCONFDIR)/MASTER.hakios)
+
 ifneq (,$(wildcard $(MASTERCONFDIR)/MASTER.$(DOCONF_ARCH_CONFIG_LC).$(CURRENT_MACHINE_CONFIG_LC)))
 DOCONFDEPS += $(MASTERCONFDIR)/MASTER.$(DOCONF_ARCH_CONFIG_LC).$(CURRENT_MACHINE_CONFIG_LC)
 endif
diff --git a/bsd/conf/Makefile.arm64 b/bsd/conf/Makefile.arm64
index a4d25040f38f80993b9d43d83aa74f2d191b1513..aad72993d139c587dbc8988e3635916449ee8db4 100644
--- a/bsd/conf/Makefile.arm64
+++ b/bsd/conf/Makefile.arm64
@@ -5,6 +5,11 @@
 # Inline assembly doesn't interact well with LTO
 fbt_arm.o_CFLAGS_ADD += $(CFLAGS_NOLTO_FLAG)
 
+# libdeflate's arm headers (bsd/miscfs/apfs/libdeflate) include the compiler's own <arm_acle.h>
+# and <arm_neon.h>, which the kernel's include paths do not have: they come after those paths,
+# so the kernel's <stdint.h> and the rest are still the ones found.
+apfs_deflate.o_CFLAGS_ADD += -idirafter $(shell $(CC) -print-resource-dir)/include
+
 kern_csr.o_INCFLAGS += -I$(SRCROOT)/osfmk
 kern_debug.o_INCFLAGS += -I$(SRCROOT)/osfmk
 
diff --git a/bsd/conf/Makefile.template b/bsd/conf/Makefile.template
index 4b83160780c3eb2b1cea6e73b123da8d6e9c3150..8997af1f0e1b5946dda89103c974f021b44c956a 100644
--- a/bsd/conf/Makefile.template
+++ b/bsd/conf/Makefile.template
@@ -588,5 +588,13 @@ do_build_all:: do_all
 
 %RULES
 
+# HakiOS: HFS Plus built in (bsd/hfs, Apple's hfs-627.100.6), compiled as its kext was: against the kernel's KPI,
+# not its insides (no XNU/BSD/MACH_KERNEL_PRIVATE), kext-config.h first, its own headers beside it, and its warnings
+# its own (it is Apple's code as it was published, not this kernel's)
+HFS_OBJS = $(patsubst %.c,%.o,$(notdir $(wildcard $(SRCROOT)/bsd/hfs/*.c)))
+$(foreach o,$(HFS_OBJS),$(eval $(o)_CFLAGS_ADD += -UXNU_KERNEL_PRIVATE -UBSD_KERNEL_PRIVATE -UMACH_KERNEL_PRIVATE \
+	-include $(SRCROOT)/bsd/hfs/kext-config.h -I$(SRCROOT)/bsd/hfs -idirafter $(SDKROOT)/usr/include))
+$(foreach o,$(HFS_OBJS),$(eval $(o)_CWARNFLAGS_ADD += -w))
+
 include $(MakeInc_rule)
 include $(MakeInc_dir)
