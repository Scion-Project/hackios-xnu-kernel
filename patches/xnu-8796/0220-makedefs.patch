 # $(warning PRIMARY_KERNEL_CONFIGS is $(PRIMARY_KERNEL_CONFIGS))
 # $(warning VARIANT_CONFIGS is $(VARIANT_CONFIGS))
 
-MEMORY_SIZE := $(shell /usr/sbin/sysctl -n hw.memsize)
