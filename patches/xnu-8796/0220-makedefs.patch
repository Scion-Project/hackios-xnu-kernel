 #
 # Command to generate host binaries. Intentionally not
@@ -317,7 +317,7 @@ ifeq ($(origin HOST_GM4),undefined)
 	export HOST_GM4		:= $(shell $(XCRUN) -sdk $(HOST_SDKROOT) -find gm4)
 endif
 ifeq ($(origin HOST_CODESIGN),undefined)
